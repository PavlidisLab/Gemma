//file:noinspection GrUnresolvedAccess

// Gemma CI pipeline — 2.0 container model.
//
// Division of labour with GitHub Actions:
//   - .github/workflows/publish-image.yml builds + pushes the gemma-rest and
//     gemma-cli Docker images to GHCR on EVERY branch push (tag
//     <branch-slug>-<sha7>, plus :2.0.0-alpha/:latest on phase2-acl-migrate).
//     Jenkins does NOT build images.
//   - Jenkins runs the test matrix inside a maven:3.9-eclipse-temurin-25
//     container (so the agent needs no host JDK/Maven) and — because it sits on
//     the UBC network, unlike GHA runners — triggers the frink container deploy.
//     It no longer publishes Maven artifacts, deploys a WAR, deploys the Maven
//     site, or rsyncs the CLI; the app + CLI ship as Docker images now.
//
// Agent prerequisites (Manage Jenkins), one-time setup:
//   - Docker Pipeline plugin (enables the `docker { image ... }` agent) and a
//     working `docker` CLI on every agent that can pull public GHCR images.
//   - Image `maven:3.9-eclipse-temurin-25` pullable from the agent.
//   - Integration tests reach the gemdtest MySQL via `--network host`, so the
//     same host MySQL the old pipeline used (lock 'database/gemdtest') stays.
//   - SSH Agent plugin + an `frink-deploy-key` credential: a private key whose
//     public half is in paul@frink:~/.ssh/authorized_keys behind the
//     command="~/Gemma2.0/bin/update.sh" forced-command restriction (see the
//     header of .github/workflows/publish-image.yml for the exact setup), and
//     frink's host key pinned in the agent's ~/.ssh/known_hosts.
//   - No JDK/Maven *tool installation* is required any more.

// GHCR repo GHA publishes the REST image to; used to poll for the image before
// telling frink to pull it.
def imageRepo = 'pavlidislab/gemma-rest'

void setBuildStatus(String context, String message, String state) {
    step([
        $class            : "GitHubCommitStatusSetter",
        reposSource       : [$class: "ManuallyEnteredRepositorySource", url: "https://github.com/PavlidisLab/Gemma"],
        contextSource     : [$class: "ManuallyEnteredCommitContextSource", context: context],
        errorHandlers     : [[$class: "ChangingBuildStatusErrorHandler", result: "UNSTABLE"]],
        statusResultSource: [$class: "ConditionalStatusResultSource", results: [[$class: "AnyBuildResult", message: message, state: state]]]
    ])
}

pipeline {
    // Per-stage agents: build/test run inside a Maven container; the frink
    // deploy runs on the host (it only needs docker + ssh).
    agent none
    parameters {
        booleanParam(name: 'FORCE_INTEGRATION_TESTS', defaultValue: false, description: 'Force integration tests regardless of the branch being built.')
        booleanParam(name: 'FORCE_SLOW_TESTS', defaultValue: false, description: 'Force slow tests regardless of the branch being built.')
        booleanParam(name: 'FORCE_SONARQUBE', defaultValue: false, description: 'Force SonarQube analysis regardless of the branch being built.')
        booleanParam(name: 'FORCE_DEPLOY', defaultValue: false, description: 'Force artifact publish + frink deploy regardless of the branch being built.')
    }
    stages {
        // All Maven work shares one container + one workspace so the reactor is
        // compiled once and reused across the nested stages. Kept sequential on
        // purpose: gemdtest is single-tenant, so parallel Maven runs would
        // corrupt each other's schema.
        stage('Build & test') {
            agent {
                docker {
                    image 'maven:3.9-eclipse-temurin-25'
                    // --network host: integration tests reach the gemdtest MySQL
                    //   running on the Jenkins host.
                    // -v $HOME/.m2: cache downloaded dependencies across builds.
                    //   NOTE (sysop): the Docker Pipeline plugin runs the
                    //   container as the Jenkins uid, so $HOME/.m2 must be
                    //   writable by that uid. If you hit permission errors,
                    //   switch to a named docker volume or a workspace-local repo
                    //   (-Dmaven.repo.local=.m2).
                    args '-v $HOME/.m2:/root/.m2 --network host'
                }
            }
            stages {
                stage('Build') {
                    steps {
                        setBuildStatus "Build", "Build #${env.BUILD_NUMBER} has started...", 'PENDING'
                        // org.hdf5group:hdf5 is not published on Maven Central or
                        // the pavlab mirror — it's vendored in-repo. Install it
                        // into the container's local repo before anything
                        // resolves it (the Dockerfile and GHA image build do the
                        // same). install-file is idempotent.
                        sh 'mvn -B org.apache.maven.plugins:maven-install-plugin:3.1.4:install-file -Dfile=vendor/hdf5/hdf5-1.12.3.jar -DpomFile=vendor/hdf5/hdf5-1.12.3.pom'
                        sh 'mvn -B compile'
                    }
                    post {
                        success {
                            setBuildStatus "Build", "Build #${env.BUILD_NUMBER} succeeded.", 'SUCCESS'
                        }
                        unsuccessful {
                            setBuildStatus "Build", "Build #${env.BUILD_NUMBER} failed.", 'FAILURE'
                        }
                    }
                }
                stage('Run quick unit tests') {
                    // Runs on every branch, matching the old pipeline.
                    steps {
                        setBuildStatus "Tests", "Tests for build #${env.BUILD_NUMBER} have started...", 'PENDING'
                        sh 'mvn -B test --fail-at-end -DexcludedGroups=SlowTest'
                    }
                    post {
                        always {
                            junit testResults: '**/target/surefire-reports/*.xml'
                        }
                        success {
                            setBuildStatus "Tests", "Tests for build #${env.BUILD_NUMBER} have passed.", 'SUCCESS'
                        }
                        unsuccessful {
                            setBuildStatus "Tests", "Tests for build #${env.BUILD_NUMBER} failed.", 'FAILURE'
                        }
                    }
                }
                stage('Run slow unit tests') {
                    when {
                        anyOf {
                            // master's heavy tests already ran in hotfix/release
                            branch 'support-*'
                            branch 'hotfix-*'
                            branch 'release-*'
                            branch 'development'
                            expression { params.FORCE_SLOW_TESTS }
                        }
                    }
                    steps {
                        lock('gemma-slow-tests') {
                            setBuildStatus "Slow tests", "Slow tests #${env.BUILD_NUMBER} have started...", 'PENDING'
                            sh 'mvn -B test --fail-at-end -Dgroups=SlowTest -DskipWebpack'
                        }
                    }
                    post {
                        always {
                            junit testResults: '**/target/surefire-reports/*.xml'
                        }
                        success {
                            setBuildStatus "Slow tests", "Slow tests for build #${env.BUILD_NUMBER} have passed.", 'SUCCESS'
                        }
                        unsuccessful {
                            setBuildStatus "Slow tests", "Slow tests for build #${env.BUILD_NUMBER} failed.", 'FAILURE'
                        }
                    }
                }
                stage('Run integration tests') {
                    when {
                        anyOf {
                            branch 'support-*'
                            branch 'hotfix-*'
                            branch 'release-*'
                            branch 'development'
                            expression { params.FORCE_INTEGRATION_TESTS }
                        }
                    }
                    steps {
                        setBuildStatus "Integration tests", "Integration tests #${env.BUILD_NUMBER} have started...", 'PENDING'
                        lock('database/gemdtest') {
                            sh 'mvn -B verify --fail-at-end -DskipUnitTests -DskipJavadoc -DskipWebpack'
                        }
                    }
                    post {
                        always {
                            junit testResults: '**/target/failsafe-reports/*.xml'
                        }
                        success {
                            setBuildStatus "Integration tests", "Integration tests for build #${env.BUILD_NUMBER} have passed.", 'SUCCESS'
                        }
                        unsuccessful {
                            setBuildStatus "Integration tests", "Integration tests for build #${env.BUILD_NUMBER} failed.", 'FAILURE'
                        }
                    }
                }
                stage('SonarQube Analysis') {
                    // Runs in the JDK 25 container like everything else now — no
                    // separate JDK 17 tool. If the SonarQube server's scanner
                    // rejects JDK 25, run the scanner against pre-built classes
                    // on a supported JDK instead.
                    when {
                        anyOf {
                            branch 'master'
                            branch 'support-*'
                            branch 'hotfix-*'
                            branch 'release-*'
                            branch 'development'
                            expression { params.FORCE_SONARQUBE }
                        }
                    }
                    steps {
                        lock('gemma-sonarqube-analysis') {
                            setBuildStatus "SonarQube Analysis", "SonarQube analysis for build #${env.BUILD_NUMBER} has started...", 'PENDING'
                            withSonarQubeEnv('UBC SonarQube') {
                                sh "mvn package -DskipTests -DskipJavadoc -DskipWebpack dependency-check:check org.sonarsource.scanner.maven:sonar-maven-plugin:sonar -Dsonar.projectKey=mslg -Dsonar.projectName='MSL - Gemma'"
                            }
                        }
                    }
                    post {
                        success {
                            setBuildStatus "SonarQube analysis", "SonarQube analysis for build #${env.BUILD_NUMBER} have passed.", 'SUCCESS'
                        }
                        failure {
                            setBuildStatus "SonarQube analysis", "SonarQube analysis for build #${env.BUILD_NUMBER} failed.", 'ERROR'
                        }
                        unstable {
                            setBuildStatus "SonarQube analysis", "SonarQube analysis for build #${env.BUILD_NUMBER} failed.", 'FAILURE'
                        }
                    }
                }
            }
        }
        stage('Deploy to frink') {
            // Runs on the host (docker + ssh only; no Maven). Only phase2-acl-migrate
            // gets the :2.0.0-alpha tag that frink's update.sh pulls.
            agent any
            when {
                anyOf {
                    branch 'phase2-acl-migrate'
                    expression { params.FORCE_DEPLOY }
                }
            }
            steps {
                script {
                    // GHA and Jenkins both fire on push. Wait for GHA to finish
                    // pushing THIS commit's image before telling frink to pull,
                    // otherwise frink pulls the previous image. The commit-unique
                    // <branch-slug>-<sha7> tag is our "GHA is done" signal; on
                    // phase2-acl-migrate the same GHA run pushes :2.0.0-alpha in
                    // the same step, so once the sha tag exists, so does the tag
                    // update.sh pulls.
                    def slug = env.BRANCH_NAME.replaceAll('/', '-')
                    def sha7 = env.GIT_COMMIT.take(7)
                    def tag = "${slug}-${sha7}"
                    setBuildStatus "Deploy", "Deploy #${env.BUILD_NUMBER} waiting for image ${tag}...", 'PENDING'
                    // Poll up to ~20 min. docker manifest inspect handles GHCR
                    // auth for public images anonymously.
                    timeout(time: 20, unit: 'MINUTES') {
                        waitUntil(initialRecurrencePeriod: 20000) {
                            def rc = sh(script: "docker manifest inspect ghcr.io/${imageRepo}:${tag} >/dev/null 2>&1", returnStatus: true)
                            return rc == 0
                        }
                    }
                    // Forced-command key: whatever we send, frink runs
                    // ~/Gemma2.0/bin/update.sh (pull + bounce the container).
                    sshagent(['frink-deploy-key']) {
                        sh 'ssh -p 22000 -o BatchMode=yes -o StrictHostKeyChecking=yes paul@frink.msl.ubc.ca "~/Gemma2.0/bin/update.sh"'
                    }
                }
            }
            post {
                success {
                    setBuildStatus "Deploy", "Deploy #${env.BUILD_NUMBER} to frink succeeded.", 'SUCCESS'
                }
                unsuccessful {
                    setBuildStatus "Deploy", "Deploy #${env.BUILD_NUMBER} to frink failed.", 'FAILURE'
                }
            }
        }
    }
    post {
        fixed {
            slackSend color: 'good', message: "${env.JOB_NAME} - #${env.BUILD_NUMBER} Back to normal (<${env.BUILD_URL}|Open>)"
        }
        unsuccessful {
            slackSend color: 'danger', message: "${env.JOB_NAME} - #${env.BUILD_NUMBER} Failure (<${env.BUILD_URL}|Open>)"
        }
    }
}
