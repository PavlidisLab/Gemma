//file:noinspection GrUnresolvedAccess

def buildHash
def gemmaVersion
def baseCodeVersion
def dataDir
def deployRef
def deployServer
def cliRef
def cliWikiPageSuffix

void setBuildStatus(String context, String message, String state) {
    step([
        $class            : "GitHubCommitStatusSetter",
        reposSource       : [$class: "ManuallyEnteredRepositorySource", url: "https://github.com/PavlidisLab/Gemma"],
        contextSource     : [$class: "ManuallyEnteredCommitContextSource", context: context],
        errorHandlers     : [[$class: "ChangingBuildStatusErrorHandler", result: "UNSTABLE"]],
        statusResultSource: [$class: "ConditionalStatusResultSource", results: [[$class: "AnyBuildResult", message: message, state: state]]]
    ])
}

pipeline {
    agent any
    tools {
        maven 'Maven 3.6.3'
    }
    environment {
        // maven.compiler.release is 25 (pom.xml), but the agent (chalmers, the
        // built-in node) defaults to JAVA_HOME=jre-21-openjdk with java 11 first on
        // PATH, so an unpinned build dies with "release version 25 not supported".
        //
        // Pointing at chalmers' own /usr/lib/jvm/java-25-openjdk does NOT work, and
        // it fails in a way that reads like a JDK bug rather than a missing package:
        // the installed RPMs are java-25-openjdk + -headless + -crypto-adapter with
        // no -devel, so that directory has bin/java but NO bin/javac. Maven starts on
        // 25 happily; then maven-compiler-plugin finds no in-process compiler, forks
        // an external javac, PATH resolves that to /usr/bin/javac (11.0.25), and javac
        // 11 rejects --release 25. Build #3 died exactly there, having reported
        // "Java version: 25.0.4" moments earlier.
        //
        // So use a complete JDK on shared storage: /space/opt is the same NFS
        // directory the Jenkins Maven tool already resolves to
        // (/space/opt/apache-maven-3.6.3), so chalmers demonstrably reads from it.
        // Verified there: javac 25.0.3, compiles at --release 25.
        //
        // The durable fix is `dnf install java-25-openjdk-devel` on chalmers, after
        // which this can point back at /usr/lib/jvm/java-25-openjdk — or become
        // `tools { jdk 'Java 25' }` if a tool installation is ever added. Note that
        // the tools/environment split matters: a stage-level `tools { jdk ... }` and
        // a pipeline-level environment JAVA_HOME both write JAVA_HOME and would fight
        // over it, which is why the SonarQube stage below no longer pins its own JDK.
        JAVA_HOME = '/space/opt/temurin-25.0.3'
        PATH = "${JAVA_HOME}/bin:${PATH}"
        GEMMA_CLI_WIKI_DEPLOY_TOKEN = credentials('confluence-wiki-token')
    }
    parameters {
        string(name: 'DATA_DIR', defaultValue: '/space/gemmaData', description: 'Directory where production data is stored.')
        string(name: 'STAGING_DATA_DIR', defaultValue: '/space/staginggemmaData', description: 'Directory where staging data is stored.')
        string(name: 'DEV_DATA_DIR', defaultValue: '/space/sandboxgemmaData', description: 'Directory where development data is stored.')
        string(name: 'MAVEN_SITES_DIR', defaultValue: '/space/web/maven-sites', description: 'Directory where Maven sites are deployed.')
        string(name: 'CLI_DIR_PREFIX', defaultValue: '/space/opt/gemma-cli', description: 'Prefix for Gemma CLI deployment directory.')
        string(name: 'DEPLOY_DIR_PREFIX', defaultValue: '/var/local/tomcat', description: 'Prefix for Gemma REST deployment directories. These are the same Tomcat instance directories gemma-web used.')
        // either hotfix or release, we only have one staging server & CLI symlink
        choice(name: 'STAGING_BRANCH', choices: ['hotfix', 'release'], description: 'Branch deployed to the staging server and CLI symlink.')
        // whether or not to force integration tests
        booleanParam(name: 'FORCE_INTEGRATION_TESTS', defaultValue: false, description: 'Force integration tests to be performed regardless of the branch being built.')
        booleanParam(name: 'FORCE_SLOW_TESTS', defaultValue: false, description: 'Force slow tests to be performed regardless of the branch being built.')
        booleanParam(name: 'FORCE_DEPLOY', defaultValue: false, description: 'Force deployment to be performed regardless of the branch being built.')
        booleanParam(name: 'FORCE_SONARQUBE', defaultValue: false, description: 'Force SonarQube analysis to be performed regardless of the branch being built.')
    }
    stages {
        stage('Checkout scm') {
            steps {
                checkout scm
                script {
                    gemmaVersion = sh script: 'mvn help:evaluate -Dexpression=project.version -q -DforceStdout', returnStdout: true
                    baseCodeVersion = sh script: 'mvn help:evaluate -Dartifact=baseCode:baseCode -Dexpression=project.version -q -DforceStdout', returnStdout: true
                    buildHash = env.GIT_COMMIT
                    def productionBuild = env.BRANCH_NAME == 'master'
                    def supportBuild = env.BRANCH_NAME.startsWith('support-')
                    def stagingBuild = env.BRANCH_NAME =~ '^' + params.STAGING_BRANCH + '-.*'
                    if (productionBuild) {
                        if (gemmaVersion.endsWith('-SNAPSHOT')) {
                            error("A production build must not have a -SNAPSHOT suffix.")
                        }
                        dataDir = params.DATA_DIR
                        deployServer = 'moe'
                        deployRef = 'gemma'
                        cliRef = 'production'
                        cliWikiPageSuffix = ' (generated)'
                    } else if (supportBuild) {
                        if (gemmaVersion.endsWith('-SNAPSHOT')) {
                            error("A support build must not have a -SNAPSHOT suffix.")
                        }
                    } else if (stagingBuild) {
                        if (!gemmaVersion.endsWith("-SNAPSHOT")) {
                            error("A staging build must have a -SNAPSHOT suffix.")
                        }
                        dataDir = params.STAGING_DATA_DIR
                        deployServer = 'chalmers'
                        deployRef = 'gemma-staging'
                        cliRef = 'staging'
                        cliWikiPageSuffix = ' (staging)'
                    } else {
                        if (!gemmaVersion.endsWith("-SNAPSHOT")) {
                            error("A development build must have a -SNAPSHOT suffix.")
                        }
                        dataDir = params.DEV_DATA_DIR
                        deployServer = 'chalmers'
                        deployRef = 'gemma'
                        cliRef = gemmaVersion
                        cliWikiPageSuffix = ' (development)'
                    }
                }
                sh 'mvn -B clean'
            }
        }
        stage('Build') {
            steps {
                setBuildStatus "Build", "Build #${env.BUILD_NUMBER} has started...", 'PENDING'
                // A receipt in the log of which JDK and Maven this build actually got.
                // The 'Maven 3.6.3' tool is vanilla Apache, released six years before
                // JDK 25; if it ever chokes on a newer JDK, drop the `tools` block and
                // use /usr/bin/mvn, which is Red Hat's patched 3.6.3-15 — the same
                // build the dev boxes compile Gemma with on JDK 25.
                sh 'mvn -version'
                // org.hdf5group:hdf5 is on neither Maven Central nor the pavlab mirror;
                // it is vendored in-repo. Install it into the local repository before
                // anything tries to resolve it. Without this the failed lookup writes
                // *.lastUpdated markers into ~/.m2, and Maven then refuses to retry the
                // remote until its update interval elapses — so the build keeps failing
                // for the rest of the day without so much as another attempt.
                // install-file is idempotent, so this is safe to re-run every build.
                sh 'mvn -B org.apache.maven.plugins:maven-install-plugin:3.1.4:install-file -Dfile=vendor/hdf5/hdf5-1.12.3.jar -DpomFile=vendor/hdf5/hdf5-1.12.3.pom'
                sh 'mvn -B compile'
            }
            post {
                success {
                    setBuildStatus "Build", "Build #${env.BUILD_NUMBER} succeeded.", 'SUCCESS'
                }
                unsuccessful {
                    setBuildStatus "Build", "Build #${env.BUILD_NUMBER} failed.", 'FAILURE'
                }
            }
        }
        stage('Run quick unit tests') {
            steps {
                setBuildStatus "Tests", "Tests for build #${env.BUILD_NUMBER} have started...", 'PENDING'
                // No -DexcludedGroups here on purpose: the pom's own default applies,
                // which surefire consumes as `integration,${excludedGroups}` =
                // integration,network,slow (pom.xml ~1113 and ~1737).
                //
                // This used to pass -DexcludedGroups=SlowTest, which was worse than a
                // no-op. @Category(SlowTest) exists in zero test files today, so it
                // excluded nothing — while REPLACING the network,slow default, which
                // pulled all 78 @Tag("slow") files and the network-bound ones into the
                // stage that is supposed to be the fast signal. Build #4 spent 15m20s
                // here and failed on live NCBI calls.
                sh 'mvn -B test --fail-at-end'
            }
            post {
                always {
                    junit testResults: '**/target/surefire-reports/*.xml'
                }
                success {
                    setBuildStatus "Tests", "Tests for build #${env.BUILD_NUMBER} have passed.", 'SUCCESS'
                }
                unsuccessful {
                    setBuildStatus "Tests", "Tests for build #${env.BUILD_NUMBER} failed.", 'FAILURE'
                }
            }
        }
        stage('Package') {
            steps {
                setBuildStatus "Package", "Package for build #${env.BUILD_NUMBER} have started...", 'PENDING'
                sh 'mvn -B package -DskipTests'
            }
            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.jar, **/target/*.war', fingerprint: true
                    setBuildStatus "Package", "Package for build #${env.BUILD_NUMBER} have passed.", 'SUCCESS'
                }
                unsuccessful {
                    setBuildStatus "Package", "Package for build #${env.BUILD_NUMBER} failed.", 'FAILURE'
                }
            }
        }
        stage('Run integration tests and perform deployment in parallel') {
            when {
                anyOf {
                    branch 'master'
                    branch 'support-*'
                    branch 'hotfix-*'
                    branch 'release-*'
                    branch 'development'
                    expression { params.FORCE_INTEGRATION_TESTS }
                    expression { params.FORCE_SLOW_TESTS }
                    expression { params.FORCE_SONARQUBE }
                    expression { params.FORCE_DEPLOY }
                }
            }
            parallel {
                stage('Run slow unit tests') {
                    when {
                        anyOf {
                            // we can safely ignore integration tests on the master branch, those were run in hotfix/release
                            branch 'support-*'
                            branch 'hotfix-*'
                            branch 'release-*'
                            branch 'development'
                            expression { params.FORCE_SLOW_TESTS }
                        }
                    }
                    steps {
                        lock('gemma-slow-tests') {
                            setBuildStatus "Slow tests", "Slow tests #${env.BUILD_NUMBER} have started...", 'PENDING'
                            // -Dgroups=slow selects the Jupiter tag that tests actually
                            // carry; the old -Dgroups=SlowTest named a JUnit 4 category
                            // that no test uses any more, so this stage selected nothing
                            // and silently passed.
                            //
                            // -DexcludedGroups=network is required alongside it, not
                            // optional: the default exclusion list contains `slow`, and
                            // an excluded group beats a selected one, so -Dgroups=slow
                            // on its own would run zero tests. Overriding to `network`
                            // drops slow from the exclusions and keeps network out.
                            sh 'mvn -B test --fail-at-end -Dgroups=slow -DexcludedGroups=network -DskipWebpack'
                        }
                    }
                    post {
                        always {
                            junit testResults: '**/target/surefire-reports/*.xml'
                        }
                        success {
                            setBuildStatus "Slow tests", "Slow tests for build #${env.BUILD_NUMBER} have passed.", 'SUCCESS'
                        }
                        unsuccessful {
                            setBuildStatus "Slow tests", "Slow tests for build #${env.BUILD_NUMBER} failed.", 'FAILURE'
                        }
                    }
                }
                stage('Run integration tests') {
                    when {
                        anyOf {
                            // we can safely ignore integration tests on the master branch, those were run in hotfix/release
                            branch 'support-*'
                            branch 'hotfix-*'
                            branch 'release-*'
                            branch 'development'
                            expression { params.FORCE_INTEGRATION_TESTS }
                        }
                    }
                    steps {
                        setBuildStatus "Integration tests", "Integration tests #${env.BUILD_NUMBER} have started...", 'PENDING'
                        lock('database/gemdtest') {
                            sh 'mvn -B verify --fail-at-end -DskipUnitTests -DskipJavadoc -DskipWebpack'
                        }
                    }
                    post {
                        always {
                            junit testResults: '**/target/failsafe-reports/*.xml'
                        }
                        success {
                            setBuildStatus "Integration tests", "Integration tests for build #${env.BUILD_NUMBER} have passed.", 'SUCCESS'
                        }
                        unsuccessful {
                            setBuildStatus "Integration tests", "Integration tests for build #${env.BUILD_NUMBER} failed.", 'FAILURE'
                        }
                    }
                }
                stage('SonarQube Analysis') {
                    // Was pinned to `tools { jdk 'Java 17' }`. It can't be any more:
                    // this stage runs `mvn package` first, and maven.compiler.release
                    // is 25, which javac 17 cannot emit. So it inherits the pipeline's
                    // JDK 25 like every other stage. If the SonarQube server's scanner
                    // turns out to reject 25, the fix is to run the scanner alone
                    // against pre-built classes on a JDK it accepts — not to move the
                    // compile back to 17.
                    when {
                        anyOf {
                            branch 'master'
                            branch 'support-*'
                            branch 'hotfix-*'
                            branch 'release-*'
                            branch 'development'
                            expression { params.FORCE_SONARQUBE }
                        }
                    }
                    steps {
                        lock('gemma-sonarqube-analysis') {
                            setBuildStatus "SonarQube Analysis", "SonarQube analysis for build #${env.BUILD_NUMBER} has started...", 'PENDING'
                            withSonarQubeEnv('UBC SonarQube') {
                                sh "mvn package -DskipTests -DskipJavadoc -DskipWebpack dependency-check:check org.sonarsource.scanner.maven:sonar-maven-plugin:sonar -Dsonar.projectKey=mslg -Dsonar.projectName='MSL - Gemma'"
                            }
                        }
                    }
                    post {
                        success {
                            setBuildStatus "SonarQube analysis", "SonarQube analysis for build #${env.BUILD_NUMBER} have passed.", 'SUCCESS'
                        }
                        failure {
                            setBuildStatus "SonarQube analysis", "SonarQube analysis for build #${env.BUILD_NUMBER} failed.", 'ERROR'
                        }
                        unstable {
                            setBuildStatus "SonarQube analysis", "SonarQube analysis for build #${env.BUILD_NUMBER} failed.", 'FAILURE'
                        }
                    }
                }
                stage('Deploy artifacts') {
                    when {
                        anyOf {
                            branch 'master'
                            branch 'hotfix-*'
                            branch 'release-*'
                            branch 'development'
                            expression { params.FORCE_DEPLOY }
                        }
                    }
                    steps {
                        sh 'mvn -B deploy -DskipTests -DskipJavadoc -DskipWebpack'
                    }
                }
                stage('Deploy Maven website') {
                    when {
                        anyOf {
                            branch 'master'
                            branch 'hotfix-*'
                            branch 'release-*'
                            branch 'development'
                            expression { params.FORCE_DEPLOY }
                        }
                    }
                    steps {
                        sh 'mvn -B site-deploy -DskipWebpack'
                        script {
                            // maven site-deploy changes permission on the parent site directory (pavlab-starter-parent),
                            // but the Gemma site directory is not a subdirectory of it.
                            // This is replicating what the plugin is doing https://maven.apache.org/plugins/maven-site-plugin/deploy-mojo.html 
                            sh "chmod -Rf g+w,a+rX ${params.MAVEN_SITES_DIR}/gemma/gemma-${gemmaVersion} || true"
                            if (dataDir != null) {
                                sh "ln -Tsf ${params.MAVEN_SITES_DIR}/gemma/gemma-${gemmaVersion} ${dataDir}/gemma-devsite"
                                sh "ln -Tsf ${params.MAVEN_SITES_DIR}/baseCode/baseCode-${baseCodeVersion} ${dataDir}/baseCode-site"
                            }
                        }
                    }
                }
                // Replaces 'Deploy Gemma Web', which died with the gemma-web module in
                // bb154eee88. That WAR carried gemma-rest as a compile-scope jar, so
                // one deploy shipped the browser UI and /rest/v2/* together; this ships
                // the REST API alone, into the same Tomcat instance directories, on the
                // same branch-to-server map gemma-web used.
                stage('Deploy Gemma REST') {
                    when {
                        anyOf {
                            branch 'master'
                            // we only support one staging server
                            branch params.STAGING_BRANCH + '-*'
                            branch 'development'
                            expression { params.FORCE_DEPLOY }
                        }
                    }
                    steps {
                        // The WAR exists only under the gemma-rest-war profile — the
                        // Package stage above builds gemma-rest as a JAR, which is what
                        // 'Deploy artifacts' publishes to the pavlab repo, and flipping
                        // that default would change what consumers of the artifact get
                        // (see the rationale in gemma-rest/pom.xml).
                        //
                        // -am is needed because `package` does not install gemma-core
                        // into the local repository, so gemma-rest cannot resolve it
                        // from a previous stage's output.
                        sh 'mvn -B -P gemma-rest-war package -pl gemma-rest -am -DskipTests -DskipJavadoc -DskipWebpack'
                        sh "env GEMMA_REST_DEPLOY_SERVER=${deployServer} GEMMA_REST_PREFIX=${params.DEPLOY_DIR_PREFIX} ./gemma-rest/deploy.sh ${deployRef}"
                    }
                }
                stage('Deploy Gemma CLI') {
                    when {
                        anyOf {
                            branch 'master'
                            branch params.STAGING_BRANCH + '-*'
                            // never deploy the development CLI, it's too risky
                            // branch 'development'
                            expression { params.FORCE_DEPLOY }
                        }
                    }
                    steps {
                        sh "env GEMMA_CLI_PREFIX=${params.CLI_DIR_PREFIX} ./gemma-cli/deploy.sh ${cliRef}"
                        sh "env GEMMA_CLI_WIKI_PAGE_SUFFIX='${cliWikiPageSuffix}' ./gemma-cli/deploy-wiki.sh 'pavlab-wiki:Global/gemma/Gemma Landing Page/Gemma Curation/List of Gemma CLI Tools${cliWikiPageSuffix}'"
                    }
                }
            }
        }
    }
    post {
        fixed {
            slackSend color: 'good', message: "${env.JOB_NAME} - #${env.BUILD_NUMBER} Back to normal (<${env.BUILD_URL}|Open>)"
        }
        unsuccessful {
            slackSend color: 'danger', message: "${env.JOB_NAME} - #${env.BUILD_NUMBER} Failure (<${env.BUILD_URL}|Open>)"
        }
    }
}
