#!/usr/bin/env bash
#
# credential-setup.sh.example — write the gemma-rest DB password to the
# systemd LoadCredential= source file with the correct ownership and mode.
#
# Before you run this:
#   (a) Rotate the credential on the database side FIRST. If you reuse an old
#       password during rotation, the window between this script writing and
#       the old credential expiring becomes a foot-gun.
#   (b) For production prefer TPM-sealed storage:
#         systemd-creds encrypt --name=db.password - /etc/gemma/db.password.cred
#       then in the Quadlet unit use:
#         SetCredentialEncrypted=db.password:<base64-blob>
#       (or LoadCredentialEncrypted= pointing at the .cred file). That makes
#       the credential decryptable only by this unit on this host.
#   (c) Never paste the password on the command line — this script reads it
#       from stdin (or argv[1] only as an escape hatch) to keep it out of
#       shell history and the process list.
#
# Usage:
#   sudo deploy/credential-setup.sh.example          # interactive prompt
#   sudo deploy/credential-setup.sh.example -        # read one line from stdin
#   echo "$PW" | sudo deploy/credential-setup.sh.example -
#
# TODO(sysop): rename to credential-setup.sh on the server (or invoke from
# your config-management tooling) and adapt paths to your layout.

set -euo pipefail

# TODO(sysop): destination path must match LoadCredential= in the Quadlet unit.
DEST="/etc/gemma/db.password"
# TODO(sysop): owner/group — root:root is correct for rootful podman + systemd.
OWNER="root:root"
MODE="0400"

if [[ "${EUID}" -ne 0 ]]; then
    echo "ERROR: must run as root (writes to ${DEST})." >&2
    exit 1
fi

install -d -m 0755 "$(dirname "$DEST")"

password=""
if [[ "${1:-}" == "-" ]]; then
    # Read one line from stdin (no echo). `read -r` strips trailing newline.
    IFS= read -r password
elif [[ -n "${1:-}" ]]; then
    # Escape hatch: argv[1]. Discouraged — visible in process list briefly.
    password="$1"
else
    # Interactive: prompt twice, suppress echo.
    read -r -s -p "gemma_app DB password: " password; echo
    read -r -s -p "confirm: "                 confirm;  echo
    if [[ "$password" != "$confirm" ]]; then
        echo "ERROR: passwords did not match." >&2
        exit 1
    fi
fi

if [[ -z "$password" ]]; then
    echo "ERROR: empty password." >&2
    exit 1
fi

# Atomic write: tmpfile in the same directory, fchmod, rename.
tmp="$(mktemp -p "$(dirname "$DEST")" .db.password.XXXXXX)"
trap 'rm -f "$tmp"' EXIT
# No trailing newline — JDBC drivers don't strip whitespace.
printf '%s' "$password" > "$tmp"
chmod "$MODE"  "$tmp"
chown "$OWNER" "$tmp"
mv -f "$tmp" "$DEST"
trap - EXIT

echo "Wrote ${DEST} (${MODE} ${OWNER})."
echo "Now: systemctl daemon-reload && systemctl restart gemma-rest"
