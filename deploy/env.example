# Non-secret runtime config for gemma-rest.
#
# Copy to /etc/gemma/env.conf, chmod 600, owned by root.
# Secrets (DB password, API keys) do NOT go here — use LoadCredential= in the
# Quadlet unit, which surfaces them under %d as files the JVM can read.

# --- Database ---------------------------------------------------------------

# TODO(sysop): JDBC URL pointing at the production gemd instance. Adjust host,
# port, schema name, and TLS flags as required by your network policy.
GEMMA_DB_URL=jdbc:mysql://gemd-prod.msl.ubc.ca:3306/gemd?serverTimezone=UTC&useSSL=true&requireSSL=true

# TODO(sysop): read-mostly service account. Do NOT use a personal MySQL login
# or the root account. Grants should be the minimum the app needs.
GEMMA_DB_USER=gemma_app

# Password is delivered via LoadCredential= in gemma-rest.container; the
# application reads it from the file path in GEMMA_DB_PASSWORD_FILE.

# --- JVM tuning -------------------------------------------------------------

# Heap scales with the container Memory= cap via MaxRAMPercentage. Adjust if
# you change the cap or want a different headroom. G1GC is the default since
# JDK 9 — kept explicit here for visibility.
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+UseG1GC -XX:+UseStringDeduplication -XX:+ExitOnOutOfMemoryError

# Tomcat-side JVM args (Catalina-specific). preferIPv4Stack avoids dual-stack
# surprises on hosts where IPv6 is half-configured.
CATALINA_OPTS=-Djava.net.preferIPv4Stack=true

# --- Application ------------------------------------------------------------

# Data directory inside the container — matches the Volume= mount in the
# Quadlet unit. Don't change this unless you also change the mount.
GEMMA_DATA_DIR=/gemmaData

# TODO(sysop): public-facing base URL the API advertises in OpenAPI / Swagger.
# Should match the Caddy site address.
GEMMA_HOSTURL=https://gemma.example.org

# --- Logging ----------------------------------------------------------------

# Logs go to /usr/local/tomcat/logs/ inside the container, mounted to
# /var/log/gemma/ on the host. Rotation is handled by logrotate-gemma-rest.
# If you forward to a log aggregator (Loki, ELK, CloudWatch), adjust the
# image's log4j config to emit JSON to stdout and let journald carry it.

# TODO(sysop): bump to DEBUG for first-deploy troubleshooting, then dial back.
GEMMA_LOG_LEVEL=INFO
