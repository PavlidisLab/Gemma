# Non-secret runtime config for gemma-rest.
#
# Copy to /etc/gemma/env.conf, chmod 600, owned by root.
# Secrets (DB password, API keys) do NOT go here — use LoadCredential= in the
# Quadlet unit, which surfaces them under %d as files the JVM can read.

# --- Database ---------------------------------------------------------------

# TODO(sysop): JDBC URL pointing at the production gemd instance. Adjust host,
# port, schema name, and TLS flags as required by your network policy.
#
# Connector/J knobs appended below harden the JDBC socket for tunneled paths
# (e.g. SSH-forwarded port to a remote MySQL). They make a dead tunnel fail
# fast instead of stalling 30s per Hikari acquire — see
# handoffs/STATUS_HIBERNATE_SESSION_EXHAUSTION_AUDIT.md for the diagnosis.
#
#   tcpKeepAlive=true   — enable OS-level TCP keepalive probes; lets the
#                         kernel notice a half-open socket instead of waiting
#                         indefinitely for traffic.
#   socketTimeout=30000 — abort a read that has been blocked >30s. Without
#                         this, a hung tunnel keeps the driver thread parked
#                         until the kernel TCP timeout (minutes).
#   connectTimeout=10000 — fail a fresh connect attempt after 10s instead of
#                          the JDK default (~75s on most platforms).
GEMMA_DB_URL=jdbc:mysql://gemd-prod.msl.ubc.ca:3306/gemd?serverTimezone=UTC&useSSL=true&requireSSL=true&tcpKeepAlive=true&socketTimeout=30000&connectTimeout=10000

# TODO(sysop): read-mostly service account. Do NOT use a personal MySQL login
# or the root account. Grants should be the minimum the app needs.
GEMMA_DB_USER=gemma_app

# Password is delivered via LoadCredential= in gemma-rest.container; the
# application reads it from the file path in GEMMA_DB_PASSWORD_FILE.

# --- Hikari pool tuning (recommended for tunneled / long-lived deployments) -
#
# These are POOL-level knobs (HikariDataSource setters), distinct from the
# Connector/J URL knobs above. They are NOT currently bound by
# gemma-core/src/main/java/ubic/gemma/core/config/DataSourceConfig.java —
# that class only reads `gemma.db.hikari.useCursorFetch`,
# `rewriteBatchedStatements`, `connectionTimeZone`, `sessionVariables` and
# passes them through to `HikariDataSource.setDataSourceProperties` (i.e.
# driver-level). To make the values below take effect a small DataSourceConfig
# patch is required (add @Value bindings + ds.setKeepaliveTime / setMaxLifetime).
#
# TODO(sysop+dev): the documented defaults below are the recommended targets
# once DataSourceConfig is taught to honour `gemma.db.hikari.keepaliveTime`
# and `gemma.db.hikari.maxLifetime`. Until then they are advisory only.
#
#   keepaliveTime=60000   — Hikari pings each idle connection every 60s so a
#                           tunnel-dropped socket is reaped before the next
#                           acquire (Hikari default: disabled).
#   maxLifetime=1800000   — recycle each connection after 30min. MUST be
#                           shorter than MySQL `wait_timeout` (default 28800s)
#                           AND any SSH tunnel idle window — otherwise the
#                           driver will hand out a server-side-closed socket.
#
# gemma.db.hikari.keepaliveTime=60000
# gemma.db.hikari.maxLifetime=1800000

# --- JVM tuning -------------------------------------------------------------

# Heap scales with the container Memory= cap via MaxRAMPercentage. Adjust if
# you change the cap or want a different headroom. G1GC is the default since
# JDK 9 — kept explicit here for visibility.
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+UseG1GC -XX:+UseStringDeduplication -XX:+ExitOnOutOfMemoryError

# Tomcat-side JVM args (Catalina-specific). preferIPv4Stack avoids dual-stack
# surprises on hosts where IPv6 is half-configured.
CATALINA_OPTS=-Djava.net.preferIPv4Stack=true

# --- Application ------------------------------------------------------------

# Data directory inside the container — matches the Volume= mount in the
# Quadlet unit. Don't change this unless you also change the mount.
GEMMA_DATA_DIR=/gemmaData

# TODO(sysop): public-facing base URL the API advertises in OpenAPI / Swagger.
# Should match the Caddy site address.
GEMMA_HOSTURL=https://gemma.example.org

# --- Logging ----------------------------------------------------------------

# Logs go to /usr/local/tomcat/logs/ inside the container, mounted to
# /var/log/gemma/ on the host. Rotation is handled by logrotate-gemma-rest.
# If you forward to a log aggregator (Loki, ELK, CloudWatch), adjust the
# image's log4j config to emit JSON to stdout and let journald carry it.

# TODO(sysop): bump to DEBUG for first-deploy troubleshooting, then dial back.
GEMMA_LOG_LEVEL=INFO
