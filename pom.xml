	<properties>
		<!--
		Renovations Phase 2: target bytecode 17 (was 11 during Phase 0/1; was Java 8 from
		pavlab-starter-parent originally). Spring 6 requires JDK 17 at build + runtime, and its
		bundled CGLIB/ASM is class-file-version-current, so we no longer need to hold bytecode
		below the runtime JVM. Build + runtime JDK is amazon-corretto-17 (see RENOVATIONS.md).
		-->
		<maven.compiler.release>17</maven.compiler.release>
		<!-- Renovations Phase 3: emit parameter names in bytecode so Spring's
		     DefaultParameterNameDiscoverer can resolve @PreAuthorize SpEL named bindings
		     like `hasPermission(#group, 'administration')`. Without -parameters the
		     discoverer falls through to debug info / ASM (may or may not have names) and
		     ultimately Spring's SpEL evaluates `#group` to null, returning false and
		     denying admin invocations. Matched on the gsec side. -->
		<maven.compiler.parameters>true</maven.compiler.parameters>
		<!--
		Renovations Phase 2: Spring 6.1 + Spring Security 6.3 + Hibernate 6.4 + jakarta everywhere.
		Hibernate Search 5 (and its Lucene 3-era successor lineage) is gutted on this branch — the
		HS 5 -> 7 DSL rewrite is its own multi-day project. SearchService / HibernateSearchSource
		are stubbed to return empty; reinstating real ontology / entity full-text search is a future
		phase (likely on HS 7 or an external engine like OpenSearch).
		-->
		<!-- gsec.version property removed in Phase 3 absorption (gsec source absorbed into gemma-core). -->
		<!-- Spring Boot dependencies BOM (managed via dependencyManagement above). Boot 3.5.x
		     targets SF 6.2 + SS 6.5 + Hibernate 6.6 natively - matches Gemma's pins. -->
		<spring-boot.version>3.5.6</spring-boot.version>
		<spring.version>6.2.8</spring.version>
		<spring.security.version>6.5.1</spring.security.version>
		<hibernate.version>6.6.18.Final</hibernate.version>
		<!-- Flyway 10.x split out database-specific modules; tests need flyway-database-h2.
		     Production wiring (flyway-mysql) lands in the follow-on session. -->
		<flyway.version>10.22.0</flyway.version>
		<jersey.version>3.1.11</jersey.version>
		<!-- Phase 3 logging: bump slf4j-api from parent's 1.7.36 (EOL) to 2.0.x.
		     log4j-slf4j-impl (1.x bridge) swapped to log4j-slf4j2-impl in <dependencies>. -->
		<slf4j.version>2.0.16</slf4j.version>
		<jackson.version>2.21.0</jackson.version>
		<jackson-annotations.version>2.21</jackson-annotations.version>
		<swagger.version>2.2.50</swagger.version>
		<!-- Lucene removed: Hibernate Search 5 was gutted in Phase 2; no direct Lucene deps required. -->
		<slack.version>1.47.0</slack.version>
		<!-- I've been running into some issues with the 1.14 series, to be investigated... -->
		<micrometer.version>1.13.11</micrometer.version>
		<!-- HDF5 -->
		<!-- You may override these in ~/.m2/settings.xml. On macOS install with the HDF Group
		     binary tarball (which ships libhdf5_java.dylib and jarhdf5-X.Y.Z.jar) and set
		     hdf5.libDir to the bundled lib/ directory. -->
		<hdf5.version>1.12.3</hdf5.version>
		<!-- directory containing the HDF5 JNI shared library -->
		<hdf5.libDir>/usr/lib64/hdf5</hdf5.libDir>
		<mysql.version>8.4.0</mysql.version>
		<tomcat.version>10.1.34</tomcat.version>
		<antlr4.version>4.13.2</antlr4.version>
		<!-- 5.0.7.Final is broken due to https://github.com/ocpsoft/prettytime/issues/276 -->
		<prettytime.version>5.0.6.Final</prettytime.version>
		<mockito.version>5.21.0</mockito.version>
		<assertj.version>3.27.7</assertj.version>
		<!-- JUnit 5 (Jupiter) migration, Phase A: Jupiter + Vintage engine + Mockito-Jupiter
		     run alongside the legacy junit:junit 4.13.2 transitive (from pavlab-starter-parent).
		     Vintage engine lets the JUnit 5 Platform run the existing ~399 JUnit 4 test classes
		     while new tests use Jupiter. Aligned to 5.12.2 to match the spring-boot 3.5.6 BOM,
		     which transitively pulls junit-jupiter-api/engine/params at 5.12.2 and
		     junit-platform-* at 1.12.2; an older pin here (e.g. 5.11.4) splits the JUnit jars
		     across versions and breaks the surefire fork with NoClassDefFoundError. -->
		<junit.jupiter.version>5.12.2</junit.jupiter.version>
		<!-- this ensures that -DexcludedGroups works properly -->
		<excludedGroups/>
		<skipJavadoc>false</skipJavadoc>
		<skipWebpack>false</skipWebpack>
		<maven.javadoc.skip>${skipJavadoc}</maven.javadoc.skip>
		<skipTests>false</skipTests>
		<skipUnitTests>${skipTests}</skipUnitTests>
		<skipIntegrationTests>${skipTests}</skipIntegrationTests>
		<skipDelombok>${skipJavadoc}</skipDelombok>
		<redirectTestOutputToFile>true</redirectTestOutputToFile>
		<!-- common JVM options -->
		<jvmOptions>
			-Djava.util.logging.manager=org.apache.logging.log4j.jul.LogManager
			-Djava.awt.headless=true
			-Dspring.security.strategy=MODE_INHERITABLETHREADLOCAL
			<!-- FIXME: remove this once we've migrated to Spring 5 -->
			--add-opens=java.base/java.lang=ALL-UNNAMED
		</jvmOptions>
		<!-- JVM options used in tests -->
		<testJvmOptions>
			${jvmOptions}
			<!-- the location of libhdf5 is system-dependent, so we do not want to add it to the default ${jvmOptions} -->
			-Djava.library.path=${hdf5.libDir}
			-javaagent:${org.mockito:mockito-core:jar}
		</testJvmOptions>
		<delombok.output>${project.build.directory}/delombok</delombok.output>
		<javadocSourcePaths>${delombok.output}</javadocSourcePaths>
	</properties>
</project>
