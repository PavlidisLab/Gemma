			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.4</version>
				<configuration>
					<argLine>${testJvmOptions}</argLine>
					<redirectTestOutputToFile>${redirectTestOutputToFile}</redirectTestOutputToFile>
					<!-- libhdf5_java.dylib has @rpath references to libhdf5.200.dylib; java.library.path
					     only resolves the JNI lib itself, not its dynamic-link dependencies. macOS uses
					     DYLD_LIBRARY_PATH; Linux uses LD_LIBRARY_PATH. Both are set to hdf5.libDir so the
					     OS can find the C library next to the JNI shim. -->
					<environmentVariables>
						<DYLD_LIBRARY_PATH>${hdf5.libDir}</DYLD_LIBRARY_PATH>
						<LD_LIBRARY_PATH>${hdf5.libDir}</LD_LIBRARY_PATH>
					</environmentVariables>
					<includes>
						<include>**/*Test.java</include>
					</includes>
					<!--
					JUnit 5 Phase B0 dual-selector. Excludes both the legacy
					JUnit 4 @Category(IntegrationTest.class) (selected via FQCN —
					exposed as a tag by the Vintage engine) AND the new
					@Tag("integration") JUnit 5 marker. Comma-separated entries
					form a tag-expression OR on the JUnit Platform.
					-->
					<excludedGroups>ubic.gemma.core.util.test.category.IntegrationTest,integration,${excludedGroups}</excludedGroups>
					<!--suppress MavenModelInspection -->
					<skip>${skipUnitTests}</skip>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<version>3.5.4</version>
				<configuration>
					<argLine>${testJvmOptions}</argLine>
					<redirectTestOutputToFile>${redirectTestOutputToFile}</redirectTestOutputToFile>
					<includes>
						<include>**/*Test.java</include>
					</includes>
					<!--
					JUnit 5 Phase B0 dual-selector. With Surefire/Failsafe 3.x +
					Jupiter on the classpath, <groups> is a JUnit Platform tag
					expression. The Vintage engine exposes JUnit 4 @Category
					interfaces as tags named by their fully-qualified class name,
					so the FQCN below still selects @Category(IntegrationTest.class)
					classes, and "integration" picks up classes annotated with
					@Tag("integration"). The | operator is JUnit Platform OR.
					-->
					<groups>ubic.gemma.core.util.test.category.IntegrationTest | integration</groups>
					<!--suppress MavenModelInspection -->
					<skip>${skipIntegrationTests}</skip>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
