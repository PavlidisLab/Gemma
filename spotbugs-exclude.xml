<?xml version="1.0" encoding="UTF-8"?>
<!--
    SpotBugs exclude filter for Gemma.

    Wired via spotbugs-maven-plugin in the parent pom.xml. Invoked on-demand
    with `mvn spotbugs:spotbugs` or `mvn spotbugs:check`; NOT bound to the
    default verify phase (kept off the hot path).

    Suppression rationale lives next to each Match block. Add new blocks
    narrowly — never blanket-suppress a Bug pattern across the whole tree.
-->
<FindBugsFilter>

    <!--
        ubic.gemma.model.* entity classes inherit equals + hashCode from
        AbstractIdentifiable / AbstractDescribable, which declare both methods
        abstract. SpotBugs flags each subclass individually for "equals
        without hashCode" / "doesn't override equals" because it inspects only
        the subclass bytecode; the contract is honoured via the abstract
        declaration. ~33 false positives suppressed here.
    -->
    <Match>
        <Class name="~ubic\.gemma\.model\..*"/>
        <Bug pattern="EQ_DOESNT_OVERRIDE_EQUALS,HE_EQUALS_USE_HASHCODE,HE_INHERITS_EQUALS_USE_HASHCODE,HE_HASHCODE_NO_EQUALS,HE_EQUALS_NO_HASHCODE"/>
    </Match>

    <!--
        Test sources are not on the static-analysis hot path. Surefire / JUnit
        idioms (deliberate nulls, fake credentials, swallowed exceptions in
        @Test stubs) generate too much noise to be useful.
    -->
    <Match>
        <Source name="~.*/src/test/.*"/>
    </Match>
    <Match>
        <Class name="~.*Test$"/>
    </Match>
    <Match>
        <Class name="~.*Tests$"/>
    </Match>

    <!--
        ubic.gemma.model.* entity classes throw IllegalArgumentException /
        IllegalStateException from constructors as input validation. The
        Hibernate-3-era concern was about partially-constructed Serializable
        instances being attack vectors via finalizers — irrelevant since
        JDK 17's finaliser deprecation and not actually triggered by
        HibernateProxy interception. Suppress so the priority-1 list focuses
        on real bugs. See SPOTBUGS_FIRST_PASS.md (114 findings).
    -->
    <Match>
        <Class name="~ubic\.gemma\.model\..*"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!--
        SQL_INJECTION_HIBERNATE findings in *DaoImpl classes are exclusively
        safe-by-construction:
          - Class.getSimpleName() / SessionFactory.getMetamodel().entity(class).getName()
            type dispatch
          - private static final String HQL constants
          - asc/desc literals from typed booleans
          - column names validated by FilterArg.getFilterableProperties()
            (throws on unknown)
        See SQL_INJECTION_HIBERNATE_TRIAGE.md for the full per-finding analysis
        (80/80 of DAO-layer findings reviewed). Suppressing at the DAO layer
        keeps any NEW SQL_INJECTION_HIBERNATE finding visible (most likely
        candidates: gemma-rest layer, which has 0 today).
    -->
    <Match>
        <Class name="~ubic\.gemma\.persistence\.service\..*DaoImpl"/>
        <Bug pattern="SQL_INJECTION_HIBERNATE"/>
    </Match>
    <!--
        AclLinterServiceImpl concatenates metamodel entity names into HQL
        (4 hits) — same safe-by-construction pattern as the DAO layer.
    -->
    <Match>
        <Class name="ubic.gemma.core.security.acl.AclLinterServiceImpl"/>
        <Bug pattern="SQL_INJECTION_HIBERNATE"/>
    </Match>

    <!--
        Entity getters/setters expose mutable collections (Set, List, Map)
        because Hibernate's PersistentSet/Bag/Map wrappers REQUIRE that
        reference identity for lazy-init and dirty tracking. Defensive copy /
        Collections.unmodifiableX wrapping breaks Hibernate semantics. The
        findings are correct from a pure-Java OOP standpoint but inapplicable
        to JPA entities. ~1,475 combined findings (SPOTBUGS_FIRST_PASS.md).
    -->
    <Match>
        <Class name="~ubic\.gemma\.model\..*"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

</FindBugsFilter>
