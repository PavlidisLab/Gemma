<?xml version="1.0" encoding="UTF-8"?>
<site xmlns="http://maven.apache.org/SITE/2.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://maven.apache.org/SITE/2.0.0 https://maven.apache.org/xsd/site-2.0.0.xsd">
    <skin>
        <groupId>org.apache.maven.skins</groupId>
        <artifactId>maven-fluido-skin</artifactId>
        <version>2.1.0</version>
    </skin>
    <bannerLeft href="https://gemma.msl.ubc.ca">
        <!--
        The height attribute on the image is translated to a CSS attribute, but it lacks the px suffix, so we add it
        here as a workaround. This has been reported in https://github.com/apache/maven-site-plugin/issues/1228.
         -->
        <image src="/images/gemma-logo-text.png" height="63px"/>
    </bannerLeft>
    <bannerRight href="https://www.ubc.ca/">
        <image src="/images/ubc-logo.png" height="63px"/>
    </bannerRight>
    <body>
        <menu name="Overview" inherit="top">
            <item name="Pavlidis Lab Website" href="https://pavlab.msl.ubc.ca/"/>
            <item name="REST API Documentation" href="https://gemma.msl.ubc.ca/resources/restapidocs/"/>
            <item name="R Package" href="https://www.bioconductor.org/packages/release/bioc/html/gemma.R.html"/>
            <item name="Python Package" href="https://pypi.org/project/gemmapy/"/>
            <item name="Help and Documentation" href="https://pavlidislab.github.io/Gemma/"/>
        </menu>
        <!-- FIXME: the parent site is not properly resolved when hosted on the dev website <menu ref="parent" inherit="top"/> -->
        <menu ref="modules" inherit="top"/>
        <menu ref="reports" inherit="top"/>
    </body>
</site>