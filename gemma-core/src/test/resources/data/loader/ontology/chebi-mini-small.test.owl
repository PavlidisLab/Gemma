    <!-- http://purl.obolibrary.org/obo/CHEBI_35604 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35604">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25696"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35406"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36963"/>
        <obo:IAO_0000115>A negative ion consisting solely of carbon and oxygen  atoms, and therefore having the general formula C&lt;small&gt;&lt;sub&gt;&lt;em&gt;x&lt;/em&gt;&lt;/sub&gt;&lt;/small&gt;O&lt;small&gt;&lt;sub&gt;&lt;em&gt;y&lt;/em&gt;&lt;/sub&gt;&lt;/small&gt;&lt;small&gt;&lt;sup&gt;&lt;em&gt;n&lt;/em&gt;−&lt;/small&gt;&lt;/sup&gt; for some integers &lt;em&gt;x&lt;/em&gt;, &lt;em&gt;y&lt;/em&gt; and &lt;em&gt;n&lt;/em&gt;.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:35604</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
        <rdfs:label>carbon oxoanion</rdfs:label>
    </owl:Class>
    


