        <oboInOwl:id>CHEBI:35406</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
        <rdfs:label>oxoanion</rdfs:label>
    </owl:Class>
    


