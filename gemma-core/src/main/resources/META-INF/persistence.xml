<?xml version="1.0" encoding="UTF-8"?>
<!--
  Renovations Phase 2: Spring 6 + Hibernate 6 + jakarta.

  Single source of truth for Gemma's Hibernate mapping resources. Consumed by:
   - Production wiring in applicationContext-hibernate.xml (via persistenceUnitName)
   - Test wiring in BaseDatabaseTest (same persistence-unit name)

  Replaces the legacy gemma-core/src/main/resources/hibernate.cfg.xml, which was a
  Hibernate-native configuration (deprecated since the move to JPA / Spring's
  LocalContainerEntityManagerFactoryBean).

  Coexpression .hbm.xml files were deleted in Phase 2 Step 3 (subsystem retired).
  SampleCoexpressionMatrix is retained (it's a per-EE QC artifact, not gene-gene
  coexpression).
-->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="gemma" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- gsec ACL mappings (loaded from the gsec jar on the classpath) -->
        <mapping-file>gemma/gsec/model/AclEntry.hbm.xml</mapping-file>
        <mapping-file>gemma/gsec/model/AclObjectIdentity.hbm.xml</mapping-file>
        <mapping-file>gemma/gsec/model/AclSid.hbm.xml</mapping-file>

        <!-- Gemma analysis -->
        <mapping-file>ubic/gemma/model/analysis/Analysis.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/analysis/AnalysisResultSet.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/analysis/BlacklistedEntity.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/analysis/Investigation.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/analysis/expression/ExpressionExperimentSet.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/analysis/expression/coexpression/SampleCoexpressionMatrix.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/analysis/expression/diff/ContrastResult.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/analysis/expression/diff/DifferentialExpressionAnalysisResult.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/analysis/expression/diff/GeneDifferentialExpressionMetaAnalysisResult.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/analysis/expression/diff/HitListSize.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/analysis/expression/diff/PvalueDistribution.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/analysis/expression/pca/Eigenvalue.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/analysis/expression/pca/Eigenvector.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/analysis/expression/pca/ProbeLoading.hbm.xml</mapping-file>

        <!-- Gemma association -->
        <mapping-file>ubic/gemma/model/association/BioSequence2GeneProduct.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/association/Gene2GOAssociation.hbm.xml</mapping-file>

        <!-- Common: audit and security -->
        <mapping-file>ubic/gemma/model/common/auditAndSecurity/AuditEvent.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/common/auditAndSecurity/AuditTrail.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/common/auditAndSecurity/Contact.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/common/auditAndSecurity/GroupAuthority.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/common/auditAndSecurity/JobInfo.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/common/auditAndSecurity/UserGroup.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/common/auditAndSecurity/curation/CurationDetails.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/common/auditAndSecurity/eventType/AuditEventType.hbm.xml</mapping-file>

        <!-- Common: description / measurement / protocol / quantitation -->
        <mapping-file>ubic/gemma/model/common/description/BibRefAnnotation.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/common/description/BibliographicReference.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/common/description/Characteristic.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/common/description/DatabaseEntry.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/common/description/ExternalDatabase.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/common/measurement/Measurement.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/common/measurement/Unit.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/common/protocol/Protocol.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/common/quantitationtype/QuantitationType.hbm.xml</mapping-file>

        <!-- Expression: arrays / bioassays / biomaterials -->
        <mapping-file>ubic/gemma/model/expression/arrayDesign/AlternateName.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/expression/arrayDesign/ArrayDesign.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/expression/bioAssay/BioAssay.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/expression/bioAssayData/BioAssayDimension.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/expression/bioAssayData/CellLevelCharacteristics.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/expression/bioAssayData/MeanVarianceRelation.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/expression/bioAssayData/ProcessedExpressionDataVector.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/expression/bioAssayData/ProcessedExpressionDataVectorNumberOfCells.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/expression/bioAssayData/RawExpressionDataVector.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/expression/bioAssayData/RawExpressionDataVectorNumberOfCells.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/expression/bioAssayData/SingleCellDimension.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/expression/bioAssayData/SingleCellExpressionDataVector.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/expression/biomaterial/BioMaterial.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/expression/biomaterial/Compound.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/expression/biomaterial/Treatment.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/expression/designElement/CompositeSequence.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/expression/experiment/ExperimentalDesign.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/expression/experiment/ExperimentalFactor.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/expression/experiment/FactorValue.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/expression/experiment/Geeq.hbm.xml</mapping-file>

        <!-- Genome -->
        <mapping-file>ubic/gemma/model/genome/Chromosome.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/genome/ChromosomeFeature.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/genome/PhysicalLocation.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/genome/Taxon.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/genome/biosequence/BioSequence.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/genome/gene/GeneAlias.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/genome/gene/GeneSet.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/genome/gene/GeneSetMember.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/genome/gene/Multifunctionality.hbm.xml</mapping-file>
        <mapping-file>ubic/gemma/model/genome/sequenceAnalysis/SequenceSimilaritySearchResult.hbm.xml</mapping-file>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>
    </persistence-unit>
</persistence>
