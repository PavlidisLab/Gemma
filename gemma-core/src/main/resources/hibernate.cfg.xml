<?xml version='1.0' encoding='utf-8'?>
<!DOCTYPE hibernate-configuration PUBLIC
    "-//Hibernate/Hibernate Configuration DTD//EN"
    "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<!--
  Hibernate 6 native bootstrap. Phase 2 briefly tried a JPA-based bootstrap via
  META-INF/persistence.xml + LocalContainerEntityManagerFactoryBean, but Hibernate's JPA path
  hard-codes hibernate.current_session_context_class=jpa which breaks SessionFactory.getCurrentSession()
  for the HibernateTransactionManager + SpringSessionContext bridge that Gemma's DAOs rely on. So
  we're back on hibernate.cfg.xml fed to a custom HibernateSessionFactoryBean.

  Coexpression mappings deleted in Phase 2 Step 3 (subsystem retired); SampleCoexpressionMatrix
  is the lone surviving coexpression entity (per-EE QC artifact, not gene-gene coexpression).
-->
<hibernate-configuration>
    <session-factory>
        <!-- gsec ACL mappings (loaded from the gsec jar on the classpath) -->
        <mapping resource="ubic/gemma/core/security/model/AclEntry.hbm.xml"/>
        <mapping resource="ubic/gemma/core/security/model/AclObjectIdentity.hbm.xml"/>
        <mapping resource="ubic/gemma/core/security/model/AclSid.hbm.xml"/>

        <!-- Gemma analysis -->
        <mapping resource="ubic/gemma/model/analysis/Analysis.hbm.xml"/>
        <mapping resource="ubic/gemma/model/analysis/AnalysisResultSet.hbm.xml"/>
        <mapping resource="ubic/gemma/model/analysis/BlacklistedEntity.hbm.xml"/>
        <mapping resource="ubic/gemma/model/analysis/Investigation.hbm.xml"/>
        <mapping class="ubic.gemma.model.analysis.expression.ExpressionExperimentSet"/>
        <mapping class="ubic.gemma.model.analysis.expression.coexpression.SampleCoexpressionMatrix"/>
        <mapping class="ubic.gemma.model.analysis.expression.diff.ContrastResult"/>
        <mapping resource="ubic/gemma/model/analysis/expression/diff/DifferentialExpressionAnalysisResult.hbm.xml"/>
        <mapping class="ubic.gemma.model.analysis.expression.diff.GeneDifferentialExpressionMetaAnalysisResult"/>
        <mapping class="ubic.gemma.model.analysis.expression.diff.HitListSize"/>
        <mapping class="ubic.gemma.model.analysis.expression.diff.PvalueDistribution"/>
        <mapping class="ubic.gemma.model.analysis.expression.pca.Eigenvalue"/>
        <mapping class="ubic.gemma.model.analysis.expression.pca.Eigenvector"/>
        <mapping class="ubic.gemma.model.analysis.expression.pca.ProbeLoading"/>

        <!-- Gemma association -->
        <mapping resource="ubic/gemma/model/association/BioSequence2GeneProduct.hbm.xml"/>
        <mapping class="ubic.gemma.model.association.Gene2GOAssociation"/>

        <!-- Common: audit and security -->
        <mapping class="ubic.gemma.model.common.auditAndSecurity.AuditEvent"/>
        <mapping class="ubic.gemma.model.common.auditAndSecurity.AuditTrail"/>
        <!-- AuditTrail.hbm.xml retained for <database-object> ON DELETE SET NULL DDL hooks (entity moved to JPA annotations) -->
        <mapping resource="ubic/gemma/model/common/auditAndSecurity/AuditTrail.hbm.xml"/>
        <mapping resource="ubic/gemma/model/common/auditAndSecurity/Contact.hbm.xml"/>
        <mapping class="ubic.gemma.model.common.auditAndSecurity.GroupAuthority"/>
        <mapping class="ubic.gemma.model.common.auditAndSecurity.JobInfo"/>
        <mapping class="ubic.gemma.model.common.auditAndSecurity.UserGroup"/>
        <mapping class="ubic.gemma.model.common.auditAndSecurity.curation.CurationDetails"/>
        <mapping class="ubic.gemma.model.common.auditAndSecurity.curation.CurationDraft"/>
        <mapping class="ubic.gemma.model.common.auditAndSecurity.curation.Ticket"/>
        <mapping class="ubic.gemma.model.common.auditAndSecurity.curation.TicketEvent"/>
        <mapping class="ubic.gemma.model.common.auditAndSecurity.curation.TicketTarget"/>
        <mapping resource="ubic/gemma/model/common/auditAndSecurity/eventType/AuditEventType.hbm.xml"/>

        <!-- Common: description / measurement / protocol / quantitation -->
        <mapping resource="ubic/gemma/model/common/description/BibRefAnnotation.hbm.xml"/>
        <mapping class="ubic.gemma.model.common.description.BibliographicReference"/>
        <mapping resource="ubic/gemma/model/common/description/Characteristic.hbm.xml"/>
        <mapping class="ubic.gemma.model.common.description.DatabaseEntry"/>
        <mapping class="ubic.gemma.model.common.description.ExternalDatabase"/>
        <mapping class="ubic.gemma.model.common.measurement.Measurement"/>
        <mapping class="ubic.gemma.model.common.measurement.Unit"/>
        <mapping class="ubic.gemma.model.common.protocol.Protocol"/>
        <mapping class="ubic.gemma.model.common.quantitationtype.QuantitationType"/>

        <!-- Expression: arrays / bioassays / biomaterials -->
        <mapping class="ubic.gemma.model.expression.arrayDesign.AlternateName"/>
        <mapping class="ubic.gemma.model.expression.arrayDesign.ArrayDesign"/>
        <mapping class="ubic.gemma.model.expression.bioAssay.BioAssay"/>
        <mapping class="ubic.gemma.model.expression.bioAssayData.BioAssayDimension"/>
        <mapping resource="ubic/gemma/model/expression/bioAssayData/CellLevelCharacteristics.hbm.xml"/>
        <mapping class="ubic.gemma.model.expression.bioAssayData.MeanVarianceRelation"/>
        <mapping resource="ubic/gemma/model/expression/bioAssayData/ProcessedExpressionDataVector.hbm.xml"/>
        <mapping resource="ubic/gemma/model/expression/bioAssayData/ProcessedExpressionDataVectorNumberOfCells.hbm.xml"/>
        <mapping resource="ubic/gemma/model/expression/bioAssayData/RawExpressionDataVector.hbm.xml"/>
        <mapping resource="ubic/gemma/model/expression/bioAssayData/RawExpressionDataVectorNumberOfCells.hbm.xml"/>
        <mapping resource="ubic/gemma/model/expression/bioAssayData/SingleCellDimension.hbm.xml"/>
        <mapping class="ubic.gemma.model.expression.bioAssayData.SingleCellDimensionExperiment"/>
        <mapping resource="ubic/gemma/model/expression/bioAssayData/SingleCellExpressionDataVector.hbm.xml"/>
        <mapping class="ubic.gemma.model.expression.biomaterial.BioMaterial"/>
        <mapping class="ubic.gemma.model.expression.biomaterial.Compound"/>
        <mapping class="ubic.gemma.model.expression.biomaterial.Treatment"/>
        <mapping class="ubic.gemma.model.expression.designElement.CompositeSequence"/>
        <mapping class="ubic.gemma.model.expression.experiment.AgentProposal"/>
        <mapping class="ubic.gemma.model.expression.experiment.GeoScrapeWatermark"/>
        <mapping class="ubic.gemma.model.expression.experiment.ExperimentalDesign"/>
        <mapping class="ubic.gemma.model.expression.experiment.ExperimentalFactor"/>
        <mapping class="ubic.gemma.model.expression.experiment.FactorValue"/>
        <mapping class="ubic.gemma.model.expression.experiment.Geeq"/>

        <!-- Genome -->
        <mapping class="ubic.gemma.model.genome.Chromosome"/>
        <mapping resource="ubic/gemma/model/genome/ChromosomeFeature.hbm.xml"/>
        <mapping class="ubic.gemma.model.genome.PhysicalLocation"/>
        <mapping class="ubic.gemma.model.genome.Taxon"/>
        <mapping class="ubic.gemma.model.genome.biosequence.BioSequence"/>
        <mapping class="ubic.gemma.model.genome.gene.GeneAlias"/>
        <mapping class="ubic.gemma.model.genome.gene.GeneSet"/>
        <mapping class="ubic.gemma.model.genome.gene.GeneSetMember"/>
        <mapping class="ubic.gemma.model.genome.gene.Multifunctionality"/>
        <mapping resource="ubic/gemma/model/genome/sequenceAnalysis/SequenceSimilaritySearchResult.hbm.xml"/>

        <!-- Pipeline (job scheduling) -->
        <mapping class="ubic.gemma.model.pipeline.PipelineJobBatch"/>
        <mapping class="ubic.gemma.model.pipeline.PipelineJob"/>
        <mapping class="ubic.gemma.model.pipeline.PipelineJobEvent"/>
    </session-factory>
</hibernate-configuration>
