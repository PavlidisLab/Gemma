<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
   "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<!--
   Mapped against Spring Security 6's canonical acl_sid table:
     id         BIGINT PRIMARY KEY
     principal  BIT NOT NULL1 for PrincipalSid, 0 for GrantedAuthoritySid
     sid        VARCHAR(255)principal name OR authority name

   Single-table inheritance with `principal` as the discriminator column.
   AclPrincipalSid.principal (the String name) and AclGrantedAuthoritySid.grantedAuthority
   both map to the same `sid` column — Hibernate distinguishes which subclass to instantiate
   based on the discriminator. Writes flow through JdbcMutableAclService (JDBC); Hibernate is
   read-only here (mutable="false").
-->
<hibernate-mapping>
   <class name="gemma.gsec.acl.domain.AclSid" table="acl_sid" mutable="false" abstract="true"
          discriminator-value="-1">
      <cache usage="read-only"/>
      <id name="id" type="java.lang.Long" unsaved-value="null">
         <column name="id" sql-type="BIGINT"/>
         <generator class="native">
         </generator>
      </id>

      <!-- Discriminator type=integer rather than boolean so the abstract root entity can carry
           a non-conflicting discriminator value (-1) that the subclasses (0, 1) won't shadow.
           Spring Security writes 0/1 to acl_sid.principal at the JDBC layer (it treats the
           column as boolean); MySQL accepts both BIT and integer reads/writes interchangeably
           for 0/1 values. The column is declared BIT in the canonical Spring schema and
           Hibernate's hbm2ddl-generated column matches via the explicit sql-type below. -->
      <discriminator type="integer">
         <column name="principal" sql-type="BIT" not-null="true"/>
      </discriminator>

      <subclass name="gemma.gsec.acl.domain.AclPrincipalSid" discriminator-value="1">
         <property name="principal" type="java.lang.String">
            <column name="sid" not-null="true" unique="false" sql-type="VARCHAR(255)"/>
         </property>
      </subclass>

      <subclass name="gemma.gsec.acl.domain.AclGrantedAuthoritySid" discriminator-value="0">
         <property name="grantedAuthority" type="java.lang.String">
            <column name="sid" not-null="true" unique="false" sql-type="VARCHAR(255)"/>
         </property>
      </subclass>

   </class>
</hibernate-mapping>
