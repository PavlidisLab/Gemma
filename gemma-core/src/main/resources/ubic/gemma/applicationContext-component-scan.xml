<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
       http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd">

    <!--
        Phase 3 XML->Java migration: the actual component-scan (base-packages, exclude
        filters, BeanNameGenerator) now lives in ubic.gemma.core.config.ComponentScanConfig.

        This file remains as a thin bootstrap:
          1. <context:annotation-config/> registers the annotation-aware post-processors
             (ConfigurationClassPostProcessor, AutowiredAnnotationBeanPostProcessor, etc.)
             that turn @Configuration / @Bean / @Autowired into actual wiring.
          2. The single <bean class="..."/> seeds the ComponentScanConfig @Configuration
             into the context. Spring then processes its @ComponentScan, which pulls in
             every other @Configuration / @Component under ubic.gemma.core +
             ubic.gemma.persistence.

        Keeping this XML stub (rather than deleting it) preserves the existing
        classpath*:ubic/gemma/applicationContext-*.xml wildcard loader contract used by
        web.xml, BaseIntegrationTest, BaseWebIntegrationTest, BaseJerseyIntegrationTest,
        and SpringContextUtils.
    -->

    <context:annotation-config/>

    <bean class="ubic.gemma.core.config.ComponentScanConfig"/>

</beans>
