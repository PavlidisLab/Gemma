<?xml version="1.0" encoding="UTF-8"?>
<hibernate-mapping xmlns="http://www.hibernate.org/xsd/hibernate-mapping"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.hibernate.org/xsd/hibernate-mapping http://hibernate.org/xsd/hibernate-mapping-4.0.xsd">
    <!--
        Append-only record of one curation-agents proposal payload.

        See HANDOFF_PROPOSED_EXPERIMENT_WORKFLOW.md §"The decided shape"
        and handoffs/RECCE_AGENT_CURATION_UNIFICATION.md §2 + §3.

        FK -> INVESTIGATION (works for both ExpressionExperiment and
        PreboardedExperiment discriminator rows; the column is the same
        ID generator). Unique key (INVESTIGATION_FK, KIND, RUN_ID) enforces
        idempotency per the handoff's "Failure modes" §, scoped by the
        kind discriminator so a forward-looking proposal and a post-hoc
        audit can coexist on the same investigation with the same runId.

        kind defaults to PROPOSAL in the Java constructor; existing rows
        carry the schema default ('PROPOSAL' via Flyway V13/V15) so the
        column rollout is backwards-compatible.

        payloadJson is mapped as MaterializedClobType; the production
        DDL (mysql V11) materializes it as a JSON column for queryability,
        while the H2 test sibling (V13) uses CLOB — Hibernate reads/writes
        the same String either way.
    -->
    <class name="ubic.gemma.model.expression.experiment.AgentProposal" table="AGENT_PROPOSAL">
        <id name="id" type="java.lang.Long" unsaved-value="null">
            <column name="ID" sql-type="BIGINT"/>
            <generator class="native"/>
        </id>
        <many-to-one name="investigation"
                     class="ubic.gemma.model.analysis.Investigation"
                     lazy="proxy" fetch="select"
                     foreign-key="FK_AGENT_PROPOSAL_INVESTIGATION">
            <column name="INVESTIGATION_FK" not-null="true" sql-type="BIGINT"
                    index="IDX_AGENT_PROPOSAL_INVESTIGATION"
                    unique-key="UK_AGENT_PROPOSAL_INVESTIGATION_KIND_RUN"/>
        </many-to-one>
        <property name="kind">
            <column name="KIND" not-null="true" sql-type="VARCHAR(16)"
                    unique-key="UK_AGENT_PROPOSAL_INVESTIGATION_KIND_RUN"/>
            <type name="org.hibernate.type.EnumType">
                <param name="enumClass">ubic.gemma.model.expression.experiment.AgentCurationKind</param>
                <param name="useNamed">true</param>
            </type>
        </property>
        <property name="runId" type="java.lang.String">
            <column name="RUN_ID" not-null="true"
                    sql-type="VARCHAR(255)"
                    unique-key="UK_AGENT_PROPOSAL_INVESTIGATION_KIND_RUN"/>
        </property>
        <property name="agentVersion" type="java.lang.String">
            <column name="AGENT_VERSION" not-null="false" unique="false"
                    sql-type="VARCHAR(255)"/>
        </property>
        <property name="model" type="java.lang.String">
            <column name="MODEL" not-null="false" unique="false"
                    sql-type="VARCHAR(255)"/>
        </property>
        <property name="ranAt" type="java.util.Date">
            <column name="RAN_AT" not-null="false" unique="false"
                    sql-type="DATETIME"/>
        </property>
        <property name="payloadJson" type="org.hibernate.type.MaterializedClobType">
            <column name="PAYLOAD_JSON" not-null="false" unique="false"
                    sql-type="LONGTEXT"/>
        </property>
        <!--
            Lifecycle + disposition columns (Flyway mysql/V15 + h2/V17).
            STATUS is NOT NULL with a schema-side default of 'OPEN' — Hibernate
            doesn't honour the SQL default for INSERTs, so the Java entity sets
            the default in its field initializer. lastUpdated is stamped by
            the service layer on every save() to keep H2 aligned with MySQL's
            `ON UPDATE CURRENT_TIMESTAMP(3)`.
        -->
        <property name="status" type="java.lang.String">
            <column name="STATUS" not-null="true" unique="false"
                    sql-type="VARCHAR(32)"/>
        </property>
        <property name="disposition" type="java.lang.String">
            <column name="DISPOSITION" not-null="false" unique="false"
                    sql-type="VARCHAR(32)"/>
        </property>
        <property name="dispositionNote" type="org.hibernate.type.MaterializedClobType">
            <column name="DISPOSITION_NOTE" not-null="false" unique="false"
                    sql-type="TEXT"/>
        </property>
        <property name="finalizedAt" type="java.util.Date">
            <column name="FINALIZED_AT" not-null="false" unique="false"
                    sql-type="DATETIME(3)"/>
        </property>
        <property name="lastUpdated" type="java.util.Date">
            <column name="LAST_UPDATED" not-null="false" unique="false"
                    sql-type="DATETIME(3)"/>
        </property>
    </class>
</hibernate-mapping>
