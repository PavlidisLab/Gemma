<?xml version="1.0" encoding="UTF-8"?>
<hibernate-mapping xmlns="http://www.hibernate.org/xsd/hibernate-mapping"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.hibernate.org/xsd/hibernate-mapping http://hibernate.org/xsd/hibernate-mapping-4.0.xsd">

    <class name="ubic.gemma.model.pipeline.PipelineJobBatch" table="PIPELINE_JOB_BATCH">
        <cache usage="read-write"/>
        <id name="id" type="java.lang.Long" unsaved-value="null">
            <column name="ID" sql-type="BIGINT"/>
            <generator class="native"/>
        </id>
        <!-- Auditable: AuditTrail owns governance facts (who submitted, who cancelled).
             Distinct from PipelineJobEvent which carries scheduler-push facts. -->
        <many-to-one name="auditTrail" class="ubic.gemma.model.common.auditAndSecurity.AuditTrail"
                     cascade="all" lazy="proxy" fetch="select">
            <column name="AUDIT_TRAIL_FK" not-null="true" sql-type="BIGINT" unique="true"/>
        </many-to-one>
        <!-- name = batch title (curator-supplied or autogen), description = free-form note;
             both inherited from AbstractDescribable -->
        <property name="name" type="java.lang.String">
            <column name="NAME" not-null="true" sql-type="VARCHAR(255)"/>
        </property>
        <property name="description" type="org.hibernate.type.MaterializedClobType">
            <column name="DESCRIPTION" not-null="false" sql-type="text"/>
        </property>
        <property name="pipeline" type="java.lang.String">
            <column name="PIPELINE" not-null="true" sql-type="VARCHAR(64)" index="IDX_PIPELINE_JOB_BATCH_PIPELINE_STATE"/>
        </property>
        <many-to-one name="submittedBy" class="ubic.gemma.model.common.auditAndSecurity.Contact"
                     lazy="proxy" fetch="select">
            <column name="SUBMITTED_BY_FK" not-null="true" sql-type="BIGINT" index="IDX_PIPELINE_JOB_BATCH_SUBMITTED_BY"/>
        </many-to-one>
        <property name="submittedAt" type="java.util.Date">
            <column name="SUBMITTED_AT" not-null="true" sql-type="DATETIME(3)"/>
        </property>
        <property name="paramsJson" type="org.hibernate.type.MaterializedClobType">
            <column name="PARAMS_JSON" not-null="false" sql-type="longtext"/>
        </property>
        <property name="state">
            <column name="STATE" not-null="true" sql-type="VARCHAR(16)" index="IDX_PIPELINE_JOB_BATCH_PIPELINE_STATE"/>
            <type name="org.hibernate.type.EnumType">
                <param name="enumClass">ubic.gemma.model.pipeline.PipelineJobBatch$BatchState</param>
                <param name="useNamed">true</param>
            </type>
        </property>
        <property name="killRequestedAt" type="java.util.Date">
            <column name="KILL_REQUESTED_AT" not-null="false" sql-type="DATETIME(3)"/>
        </property>
        <property name="closedAt" type="java.util.Date">
            <column name="CLOSED_AT" not-null="false" sql-type="DATETIME(3)"/>
        </property>
        <set name="jobs" lazy="true" fetch="select" cascade="all,delete-orphan" inverse="true">
            <key foreign-key="FK_PIPELINE_JOB_BATCH">
                <column name="BATCH_FK" sql-type="BIGINT" not-null="true"/>
            </key>
            <one-to-many class="ubic.gemma.model.pipeline.PipelineJob"/>
        </set>
    </class>
</hibernate-mapping>
