<?xml version="1.0" encoding="UTF-8"?>
<hibernate-mapping xmlns="http://www.hibernate.org/xsd/hibernate-mapping"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.hibernate.org/xsd/hibernate-mapping http://hibernate.org/xsd/hibernate-mapping-4.0.xsd">

    <class name="ubic.gemma.model.pipeline.PipelineJob" table="PIPELINE_JOB">
        <cache usage="read-write"/>
        <id name="id" type="java.lang.Long" unsaved-value="null">
            <column name="ID" sql-type="BIGINT"/>
            <generator class="native"/>
        </id>
        <many-to-one name="batch" class="ubic.gemma.model.pipeline.PipelineJobBatch"
                     lazy="proxy" fetch="select">
            <column name="BATCH_FK" not-null="true" sql-type="BIGINT" index="IDX_PIPELINE_JOB_BATCH"/>
        </many-to-one>
        <many-to-one name="experiment"
                     class="ubic.gemma.model.expression.experiment.ExpressionExperiment"
                     lazy="proxy" fetch="select">
            <column name="EXPERIMENT_FK" not-null="true" sql-type="BIGINT" index="IDX_PIPELINE_JOB_EXPERIMENT"/>
        </many-to-one>
        <property name="state">
            <column name="STATE" not-null="true" sql-type="VARCHAR(16)" index="IDX_PIPELINE_JOB_STATE"/>
            <type name="org.hibernate.type.EnumType">
                <param name="enumClass">ubic.gemma.model.pipeline.JobState</param>
                <param name="useNamed">true</param>
            </type>
        </property>
        <property name="schedulerKind">
            <column name="SCHEDULER_KIND" not-null="false" sql-type="VARCHAR(16)"/>
            <type name="org.hibernate.type.EnumType">
                <param name="enumClass">ubic.gemma.model.pipeline.SchedulerKind</param>
                <param name="useNamed">true</param>
            </type>
        </property>
        <property name="schedulerHandle" type="java.lang.String">
            <column name="SCHEDULER_HANDLE" not-null="false" sql-type="VARCHAR(255)"/>
        </property>
        <property name="submittedAt" type="java.util.Date">
            <column name="SUBMITTED_AT" not-null="false" sql-type="DATETIME(3)"/>
        </property>
        <property name="startedAt" type="java.util.Date">
            <column name="STARTED_AT" not-null="false" sql-type="DATETIME(3)"/>
        </property>
        <property name="finishedAt" type="java.util.Date">
            <column name="FINISHED_AT" not-null="false" sql-type="DATETIME(3)"/>
        </property>
        <property name="lastEventAt" type="java.util.Date">
            <column name="LAST_EVENT_AT" not-null="false" sql-type="DATETIME(3)" index="IDX_PIPELINE_JOB_LAST_EVENT"/>
        </property>
        <property name="lastEventKind" type="java.lang.String">
            <column name="LAST_EVENT_KIND" not-null="false" sql-type="VARCHAR(32)"/>
        </property>
        <property name="lastProgressJson" type="org.hibernate.type.MaterializedClobType">
            <column name="LAST_PROGRESS_JSON" not-null="false" sql-type="text"/>
        </property>
        <property name="errorMessage" type="org.hibernate.type.MaterializedClobType">
            <column name="ERROR_MESSAGE" not-null="false" sql-type="text"/>
        </property>
        <set name="events" lazy="true" fetch="select" cascade="all,delete-orphan" inverse="true" order-by="OCCURRED_AT">
            <key foreign-key="FK_PIPELINE_JOB_EVENT_JOB">
                <column name="JOB_FK" sql-type="BIGINT" not-null="true"/>
            </key>
            <one-to-many class="ubic.gemma.model.pipeline.PipelineJobEvent"/>
        </set>
    </class>
</hibernate-mapping>
