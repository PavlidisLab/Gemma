<?xml version="1.0" encoding="UTF-8"?>
<hibernate-mapping xmlns="http://www.hibernate.org/xsd/hibernate-mapping"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.hibernate.org/xsd/hibernate-mapping http://hibernate.org/xsd/hibernate-mapping-4.0.xsd">

    <!--
        Audit Phase C-2 (per AUDIT_MIGRATION_PHASE_C_RECCE.md): the
        `mutable="false"` attribute was dropped in conjunction with the
        PostInsert/PreDelete listener cutover on AuditTrailEventListener.
        Both `mutable="false"` and the prior L2 `<cache usage="read-only"/>`
        contributed to a stale-empty-bag bug: read-only/immutable AuditEvents
        in L2 were returned by HQL on a fresh session in preference to the
        actual SQL result set after a cross-tx insert. The cache directive
        was removed earlier (notable_cases.md, ArrayDesignReportServiceTest
        baseline failures, 2026-05-19); `mutable="false"` is now also removed
        to fully retire the bug class. AuditEvent rows are conceptually
        write-once (no UPDATE flow exists on them) but we no longer instruct
        Hibernate to assume so.
    -->
    <class name="ubic.gemma.model.common.auditAndSecurity.AuditEvent" table="AUDIT_EVENT">
        <id access="field" name="id" type="java.lang.Long">
            <column name="ID" sql-type="BIGINT"/>
            <generator class="native"/>
        </id>
        <property access="field" name="date" type="java.util.Date">
            <column name="DATE" not-null="true" sql-type="DATETIME(3)" index="AUDIT_EVENT_DATE"/>
        </property>
        <property access="field" name="action">
            <column name="ACTION" not-null="true"
                    sql-type="VARCHAR(255)" index="AUDIT_EVENT_ACTION"/>
            <type name="org.hibernate.type.EnumType">
                <param name="enumClass">ubic.gemma.model.common.auditAndSecurity.AuditAction</param>
                <param name="useNamed">true</param>
            </type>
        </property>
        <property access="field" name="note"
                  type="org.hibernate.type.MaterializedClobType">
            <column name="NOTE" not-null="false" sql-type="text"/>
        </property>
        <property access="field" name="detail"
                  type="org.hibernate.type.MaterializedClobType">
            <column name="DETAIL" not-null="false" sql-type="text"/>
        </property>
        <!--
            Phase A typed-audit migration: optional JSON payload set by the
            new AuditedAspect. MySQL column is JSON; H2 mirrors as CLOB. The
            HBM type is plain MaterializedClobType because Hibernate doesn't
            ship a portable JSON ORM type and the entity treats the value as
            an opaque string anyway (the AuditEventPayload Jackson decode
            happens at the caller layer, not at the entity layer).
        -->
        <property access="field" name="payload"
                  type="org.hibernate.type.MaterializedClobType">
            <column name="PAYLOAD" not-null="false" sql-type="json"/>
        </property>
        <many-to-one access="field"
                     class="ubic.gemma.model.common.auditAndSecurity.User"
                     fetch="select" lazy="false" name="performer">
            <column name="PERFORMER_FK" not-null="false" sql-type="BIGINT"/>
        </many-to-one>
        <many-to-one access="field" cascade="all"
                     class="ubic.gemma.model.common.auditAndSecurity.eventType.AuditEventType"
                     lazy="false" fetch="join" name="eventType">
            <!-- we cannot use component mapping here because of the polymorphism of auditeventtypes see HHH1152 -->
            <column name="EVENT_TYPE_FK" not-null="false" sql-type="BIGINT" unique="true"/>
        </many-to-one>
    </class>
</hibernate-mapping>
