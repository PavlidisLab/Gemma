<?xml version="1.0" encoding="UTF-8"?>

<hibernate-mapping xmlns="http://www.hibernate.org/xsd/hibernate-mapping"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
				   xsi:schemaLocation="http://www.hibernate.org/xsd/hibernate-mapping http://hibernate.org/xsd/hibernate-mapping-4.0.xsd">

	<!--
	    Audit Phase C-2 (per AUDIT_MIGRATION_PHASE_C_RECCE.md): the
	    `mutable="false"` attribute was removed in conjunction with the
	    PostInsert/PreDelete listener cutover on AuditTrailEventListener.
	    The `mutable="false"` flag told Hibernate the entity is write-once;
	    combined with the events bag (cascade="all") and the L2 read-only
	    AuditEvent cache (now also gone, see AuditEvent.hbm.xml), it served
	    stale empty-bag results to fresh-session reads after a cross-tx
	    insert. AuditTrail rows in practice ARE updated (the events bag
	    grows on every UPDATE/CREATE/DELETE event append), so the flag was
	    a misnomer anyway. The full investigation is in notable_cases.md.
	-->
	<class name="ubic.gemma.model.common.auditAndSecurity.AuditTrail" table="AUDIT_TRAIL">
		<id name="id" type="java.lang.Long" unsaved-value="null">
			<column name="ID" sql-type="BIGINT" />
			<generator class="native">
			</generator>
		</id>
		<bag name="events" order-by="date" lazy="false" fetch="select" cascade="all">
			<key foreign-key="AUDIT_EVENT_AUDIT_TRAIL_FKC">
				<column name="AUDIT_TRAIL_FK" sql-type="BIGINT" />
			</key>
			<one-to-many class="ubic.gemma.model.common.auditAndSecurity.AuditEvent" />
		</bag>
		<!--
		    Denormalised "last event" pointer (perf hotspot B fix; see
		    AuditEventDaoImpl#getLastEvents(Class, Class)). lazy="proxy" so a
		    trail load doesn't drag the AuditEvent in — readers that want the
		    event request it explicitly. The FK column has ON DELETE SET NULL
		    at the DB level (see V6__audit_trail_last_event_id.sql) so a stray
		    event delete cannot leave a dangling FK; writers must repoint the
		    pointer on append (AuditTrailServiceImpl, AuditTrailEventListener).
		-->
		<many-to-one name="lastEvent"
		             class="ubic.gemma.model.common.auditAndSecurity.AuditEvent"
		             column="LAST_EVENT_FK"
		             lazy="proxy"
		             not-null="false"
		             foreign-key="FK_AUDIT_TRAIL_LAST_EVENT"
		             index="IDX_AUDIT_TRAIL_LAST_EVENT" />
	</class>
</hibernate-mapping>