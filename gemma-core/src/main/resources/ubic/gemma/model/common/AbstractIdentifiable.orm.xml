<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="http://www.hibernate.org/xsd/orm/mapping"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.hibernate.org/xsd/orm/mapping http://www.hibernate.org/xsd/orm/mapping-3.1.0.xsd"
                 version="3.1">
    <mapped-superclass class="ubic.gemma.model.common.AbstractIdentifiable" access="FIELD">
        <attributes>
            <id name="id">
                <column name="ID" column-definition="BIGINT"/>
                <generated-value strategy="IDENTITY"/>
            </id>
        </attributes>
    </mapped-superclass>
</entity-mappings>
