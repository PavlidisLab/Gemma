<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="http://www.hibernate.org/xsd/orm/mapping"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.hibernate.org/xsd/orm/mapping http://www.hibernate.org/xsd/orm/mapping-3.1.0.xsd"
                 version="3.1">
    <entity class="ubic.gemma.model.common.auditAndSecurity.GroupAuthority" access="FIELD">
        <table name="GROUP_AUTHORITY"/>
        <caching access="read-write"/>
        <attributes>
            <basic name="authority">
                <column name="AUTHORITY" nullable="false" column-definition="VARCHAR(255)"/>
            </basic>
        </attributes>
    </entity>
</entity-mappings>
