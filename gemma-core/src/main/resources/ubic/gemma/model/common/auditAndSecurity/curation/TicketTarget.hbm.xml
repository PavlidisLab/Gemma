<?xml version="1.0" encoding="UTF-8"?>
<hibernate-mapping xmlns="http://www.hibernate.org/xsd/hibernate-mapping"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.hibernate.org/xsd/hibernate-mapping http://hibernate.org/xsd/hibernate-mapping-4.0.xsd">

    <!--
        A single (targetType, targetId) pair attached to a Ticket. targetId is a bare FK to the
        targeted entity table (EXPRESSION_EXPERIMENT.ID, ARRAY_DESIGN.ID, ...) — intentionally
        NOT a polymorphic JPA association, so new target types can be added without an HBM change.
        The composite index on (TARGET_TYPE, TARGET_ID) — defined in the Flyway migration — supports
        the "open tickets for this entity" lookup without joining back through TICKET_FK.
    -->
    <class name="ubic.gemma.model.common.auditAndSecurity.curation.TicketTarget" table="TICKET_TARGET">
        <id name="id" type="java.lang.Long" unsaved-value="null">
            <column name="ID" sql-type="BIGINT"/>
            <generator class="native"/>
        </id>
        <many-to-one name="ticket" class="ubic.gemma.model.common.auditAndSecurity.curation.Ticket"
                     lazy="proxy" fetch="select">
            <column name="TICKET_FK" not-null="true" sql-type="BIGINT"/>
        </many-to-one>
        <property name="targetType">
            <column name="TARGET_TYPE" not-null="true" sql-type="VARCHAR(32)"/>
            <type name="org.hibernate.type.EnumType">
                <param name="enumClass">ubic.gemma.model.common.auditAndSecurity.curation.TicketTargetType</param>
                <param name="useNamed">true</param>
            </type>
        </property>
        <property name="targetId" type="java.lang.Long">
            <column name="TARGET_ID" not-null="true" sql-type="BIGINT"/>
        </property>
    </class>
</hibernate-mapping>
