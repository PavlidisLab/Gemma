<?xml version="1.0" encoding="UTF-8"?>
<!-- @author Gemma  -->
<beans xmlns:s="http://www.springframework.org/schema/security"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:util="http://www.springframework.org/schema/util"
       xmlns:aop="http://www.springframework.org/schema/aop"
       xmlns="http://www.springframework.org/schema/beans"
       xsi:schemaLocation="
            http://www.springframework.org/schema/beans
            http://www.springframework.org/schema/beans/spring-beans.xsd
            http://www.springframework.org/schema/security
            http://www.springframework.org/schema/security/spring-security.xsd
            http://www.springframework.org/schema/util
            http://www.springframework.org/schema/util/spring-util.xsd
            http://www.springframework.org/schema/aop
            http://www.springframework.org/schema/aop/spring-aop.xsd">

    <!-- import gsec definitions (manualAuthenticationService, securityService, etc.) -->
    <import resource="classpath:gemma/gsec/applicationContext-*.xml"/>

    <!-- Override gsec's Hibernate-backed ACL stack (AclServiceImpl/AclDaoImpl) with Spring
         Security 6's stock JdbcMutableAclService, wired by GemmaAclConfiguration. The schema is
         already Spring-canonical (migration db.1.33.0.sql for prod, init-acls.sql for test). The
         @Bean named "aclService" overrides gsec's bean of the same id (later definitions win in
         Spring's default bean-merge policy).

         We also redefine aclCache + aclAuthorizationStrategy via the @Configuration class. The
         gsec import contributes those beans first; the @Configuration's @Bean methods produce
         replacements with the same ids. Permission-evaluator and after-invocation providers (also
         in gsec's XML) keep working because they reference these bean ids and get the new
         implementations after the override. -->
    <bean class="ubic.gemma.core.security.acl.GemmaAclConfiguration"/>

    <!-- gsec expects two beans to be defined: userDetailsManager and groupManager -->
    <alias alias="userDetailsManager" name="userManager"/>
    <alias alias="groupManager" name="userManager"/>

    <!-- works with the HttpSessionEventPublisher configured in web.xml -->
    <bean id="sessionRegistry" class="org.springframework.security.core.session.SessionRegistryImpl"/>

    <bean id="authenticationLoggerListener" class="org.springframework.security.authentication.event.LoggerListener"/>

    <s:authentication-manager alias="authenticationManager">
        <!-- Custom DaoAuthenticationProvider that binds the username to the password
             encoder's ThreadLocal so GemmaLegacyAwarePasswordEncoder can recompute the
             legacy SHA-1(rawPassword + "{" + username + "}") hash. Configured here as a
             plain bean (below) rather than via the <s:authentication-provider
             user-service-ref="..."> namespace shortcut, because that shortcut only builds
             a vanilla DaoAuthenticationProvider. -->
        <s:authentication-provider ref="daoAuthenticationProvider"/>
        <s:authentication-provider ref="runAsAuthenticationProvider"/>
        <s:authentication-provider ref="anonymousAuthenticationProvider"/>
    </s:authentication-manager>

    <bean id="daoAuthenticationProvider"
          class="ubic.gemma.core.security.authentication.LegacyAwareDaoAuthenticationProvider">
        <property name="userDetailsService" ref="userManager"/>
        <property name="passwordEncoder" ref="passwordEncoder"/>
    </bean>

    <bean id="runAsManager" class="org.springframework.security.access.intercept.RunAsManagerImpl">
        <property name="rolePrefix" value="GROUP_"/>
        <property name="key" value="${gemma.runas.password}"/>
    </bean>

    <bean id="runAsAuthenticationProvider"
          class="org.springframework.security.access.intercept.RunAsImplAuthenticationProvider">
        <property name="key" value="${gemma.runas.password}"/>
    </bean>

    <!-- declared separately so it can be injected into UserManagerImpl directly.
         Was org.springframework.security.authentication.encoding.ShaPasswordEncoder with
         <s:salt-source user-property="username"/>; that whole package was removed in Spring
         Security 5. The Gemma-specific encoder below recognizes both the legacy
         SHA-1(rawPassword + "{" + username + "}") format (bare 40-hex digest, no prefix —
         see sql/init-data.sql) AND new BCrypt hashes ({bcrypt} prefix per
         DelegatingPasswordEncoder convention). New encodings produce BCrypt; legacy hashes
         are flagged for upgrade-on-next-login via PasswordEncoder.upgradeEncoding(). -->
    <bean id="passwordEncoder"
          class="ubic.gemma.core.security.authentication.GemmaLegacyAwarePasswordEncoder"/>


    <!--- global method security configuration -->

    <!-- Renovations Phase 3: <s:global-method-security> moved to Java config in
         ubic.gemma.core.security.MethodSecurityConfig (picked up by the component scan over
         ubic.gemma.core). That class:
           - uses @EnableGlobalMethodSecurity(securedEnabled=true, prePostEnabled=true, order=1)
             — the legacy AccessDecisionManager + AfterInvocationManager + RunAsManager stack,
             same shape as the deleted XML namespace.
           - overrides createExpressionHandler() to wire AclPermissionEvaluator + RoleHierarchy
             into the DefaultMethodSecurityExpressionHandler deterministically — the XML
             <s:expression-handler> child was not reliably doing this, which is why
             @PreAuthorize("hasPermission(...)") silently failed under the namespace.
           - overrides accessDecisionManager() / runAsManager() to return the existing beans
             (accessDecisionManager, runAsManager — defined in gsec's applicationContext-gsec.xml
             and this file respectively).
           - overrides afterInvocationManager() to aggregate the surviving after-invocation
             provider beans (Phase 3 Phase A removed afterAclRead / afterAclCollectionRead /
             afterAclMapRead / afterAclMapValuesRead in favor of @PostAuthorize /
             @PostFilter; the rest stay until Phase B custom AuthorizationManagers land)
             via a (deprecated-but-functional) AfterInvocationProviderManager. -->
    <!-- removed: <s:global-method-security ...> with 14 <s:after-invocation-provider> children -->

    <!-- Enable AspectJ autoproxy -->
    <aop:aspectj-autoproxy/>

    <!-- Renovations Phase 3: ACL maintenance fires off Hibernate PostInsert/PostDelete events
         via gemma.gsec.acl.AclEventListener (registered by AclEventListenerConfig). The
         previous @AfterReturning AOP advice on ubic.gemma.persistence.util.Pointcuts.modifier()
         was removed once the listener proved out the full 4-test ACL sweep on its own. -->


    <!-- filters (gemma-specific) -->

    <!-- After reading collection of composite sequences -->
    <bean id="afterAclCompositeSequenceCollectionRead"
          class="ubic.gemma.core.security.authorization.acl.AclEntryAfterInvocationCompositeSequenceCollectionByArrayDesignFilteringProvider">
        <constructor-arg ref="aclService"/>
        <constructor-arg value="AFTER_ACL_COMPOSITE_SEQUENCE_COLLECTION_READ"/>
        <constructor-arg>
            <list>
                <util:constant static-field="org.springframework.security.acls.domain.BasePermission.ADMINISTRATION"/>
                <util:constant static-field="org.springframework.security.acls.domain.BasePermission.READ"/>
            </list>
        </constructor-arg>
        <property name="objectIdentityRetrievalStrategy" ref="objectIdentityRetrievalStrategy"/>
        <property name="sidRetrievalStrategy" ref="sidRetrievalStrategy"/>
    </bean>

    <!-- After reading single composite sequence -->
    <bean id="afterAclCompositeSequenceRead"
          class="ubic.gemma.core.security.authorization.acl.AclEntryAfterInvocationCompositeSequenceByArrayDesignFilteringProvider">
        <constructor-arg ref="aclService"/>
        <constructor-arg value="AFTER_ACL_COMPOSITE_SEQUENCE_READ"/>
        <constructor-arg>
            <list>
                <util:constant static-field="org.springframework.security.acls.domain.BasePermission.ADMINISTRATION"/>
                <util:constant static-field="org.springframework.security.acls.domain.BasePermission.READ"/>
            </list>
        </constructor-arg>
        <property name="objectIdentityRetrievalStrategy" ref="objectIdentityRetrievalStrategy"/>
        <property name="sidRetrievalStrategy" ref="sidRetrievalStrategy"/>
    </bean>

    <!-- After reading collection of vectors -->
    <bean id="afterAclDataVectorCollectionRead"
          class="ubic.gemma.core.security.authorization.acl.AclEntryAfterInvocationDataVectorCollectionByExpressionExperimentFilteringProvider">
        <constructor-arg ref="aclService"/>
        <constructor-arg value="AFTER_ACL_DATA_VECTOR_COLLECTION_READ"/>
        <constructor-arg>
            <list>
                <util:constant static-field="org.springframework.security.acls.domain.BasePermission.ADMINISTRATION"/>
                <util:constant static-field="org.springframework.security.acls.domain.BasePermission.READ"/>
            </list>
        </constructor-arg>
        <property name="objectIdentityRetrievalStrategy" ref="objectIdentityRetrievalStrategy"/>
        <property name="sidRetrievalStrategy" ref="sidRetrievalStrategy"/>
    </bean>

    <bean id="afterAclDifferentialExpressionAnalysisResultCollectionRead"
          class="ubic.gemma.core.security.authorization.acl.AclEntryAfterInvocationDifferentialExpressionAnalysisResultCollectionByResultSetFilteringProvider">
        <constructor-arg ref="aclService"/>
        <constructor-arg value="AFTER_ACL_DIFFERENTIAL_EXPRESSION_ANALYSIS_RESULT_COLLECTION_READ"/>
        <constructor-arg>
            <list>
                <util:constant static-field="org.springframework.security.acls.domain.BasePermission.ADMINISTRATION"/>
                <util:constant static-field="org.springframework.security.acls.domain.BasePermission.READ"/>
            </list>
        </constructor-arg>
        <property name="objectIdentityRetrievalStrategy" ref="objectIdentityRetrievalStrategy"/>
        <property name="sidRetrievalStrategy" ref="sidRetrievalStrategy"/>
    </bean>

</beans>