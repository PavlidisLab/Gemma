<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
   "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<!--
   Mapped against Spring Security 6's canonical acl_object_identity table:
     id                  BIGINT PRIMARY KEY
     object_id_class     BIGINT FK -> acl_class.id
     object_id_identity  BIGINT NOT NULL
     parent_object       BIGINT FK -> acl_object_identity.id (nullable; self-ref for inheritance)
     owner_sid           BIGINT FK -> acl_sid.id
     entries_inheriting  BIT NOT NULL

   The `type` String property is derived via a Hibernate formula reading
   acl_class.class joined through object_id_class. This keeps existing HQL queries
   (`where aoi.type = :type`) working unchanged. The `objectIdClass` Long property
   exists so Hibernate's hbm2ddl generates the object_id_class FK column; Spring
   Security's JdbcMutableAclService writes it via JDBC. acl_class itself is NOT
   Hibernate-mapped — created via init-acls.sql in test, by db.1.33.0.sql in prod.

   Writes flow through JdbcMutableAclService (JDBC); Hibernate is read-only here
   (mutable="false").
-->
<hibernate-mapping>
   <class name="ubic.gemma.core.security.gsec.acl.domain.AclObjectIdentity" table="acl_object_identity" mutable="false">
      <cache usage="read-write"/>
      <id name="id" type="java.lang.Long" unsaved-value="null">
         <column name="id" sql-type="BIGINT"/>
         <generator class="native">
         </generator>
      </id>
      <property name="identifier" type="java.lang.Long">
         <column name="object_id_identity" not-null="true" unique="false" sql-type="BIGINT"/>
      </property>
      <property name="objectIdClass" type="java.lang.Long">
         <column name="object_id_class" not-null="true" unique="false" sql-type="BIGINT"/>
      </property>
      <property name="type" type="java.lang.String"
                formula="(select c.class from acl_class c where c.id = object_id_class)"/>
      <property name="entriesInheriting" type="java.lang.Boolean">
         <column name="entries_inheriting" not-null="true" unique="false" sql-type="BIT"/>
      </property>
      <many-to-one name="ownerSid" class="ubic.gemma.core.security.gsec.acl.domain.AclSid" lazy="false" fetch="select">
         <column name="owner_sid" not-null="true" sql-type="BIGINT"/>
      </many-to-one>
      <many-to-one name="parentObject" class="ubic.gemma.core.security.gsec.acl.domain.AclObjectIdentity" lazy="false" fetch="select">
         <column name="parent_object" not-null="false" sql-type="BIGINT"/>
      </many-to-one>
      <set name="entries" lazy="false" fetch="select" cascade="none" order-by="ace_order">
         <cache usage="read-write"/>
         <key foreign-key="none">
            <column name="acl_object_identity" sql-type="BIGINT"/>
         </key>
         <one-to-many class="ubic.gemma.core.security.gsec.acl.domain.AclEntry"/>
      </set>
   </class>
</hibernate-mapping>
