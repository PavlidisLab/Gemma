<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd"
       profile="web">
    <!--
        Renovations Phase 3: the Google Analytics 4 provider wiring moved to the Java
        @Configuration class below (ubic.gemma.rest.analytics.ga4.AnalyticsConfig), which itself
        carries @Profile("web"). The profile attribute on this <beans> element stays as belt-and-
        suspenders so the AnalyticsConfig bean is not registered outside the web profile.
    -->
    <bean class="ubic.gemma.rest.analytics.ga4.AnalyticsConfig"/>
</beans>
