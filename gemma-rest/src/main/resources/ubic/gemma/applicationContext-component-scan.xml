<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
    <!--
        Renovations Phase 3: the component-scan + exclude-filter that used to live here have moved to
        the Java @Configuration class below. This XML stub remains so the gemma-rest module continues
        to be picked up by the wildcard loader (classpath*:ubic/gemma/applicationContext-*.xml in
        SpringContextUtils and web.xml) without any classpath-order surgery.
    -->
    <bean class="ubic.gemma.rest.util.RestComponentScanConfig"/>
</beans>
