<?xml version="1.0" encoding="UTF-8"?>
<!--
    gemma-rest standalone WAR bootstrap (Phase 1 of GEMMA_REST_STANDALONE_ROADMAP.md).

    This descriptor is the gemma-rest-owned replacement for the Jersey/Spring/Security
    declarations currently living in gemma-web/src/main/webapp/WEB-INF/web.xml. It is
    NOT YET ACTIVE in the default build — gemma-rest still packages as a JAR by
    default so gemma-web's WAR build keeps working unchanged. To produce a standalone
    gemma-rest WAR, activate the `gemma-rest-war` profile:

        mvn -pl gemma-rest -am package -P gemma-rest-war -DskipTests

    The bean wiring is identical to gemma-web's bootstrap minus gemma-web-specific
    listeners (StartupListener, UserCounterListener), filters (sitemesh, encodingFilter
    on form-login URLs, gemmaWebMetricsFilter), and servlets (DispatcherServlet,
    DefaultServlet, JSP error pages). What remains is the bare minimum to serve
    /rest/v2/** authenticated via the Spring Security 6 filter chain assembled by
    `ubic.gemma.rest.security.RestSecurityConfig`.

    Servlet 6 / Jakarta EE namespace. Container target: Tomcat 10.1.x.
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Gemma REST</display-name>

    <!--
        Spring root context. Same classpath glob as gemma-web today: catches
        gemma-core's applicationContext-*.xml zoo plus gemma-rest's own
        applicationContext-{analytics,component-scan}.xml. gemma-web's contributions
        (applicationContext-{security,serviceBeans,component-scan,metrics}.xml)
        will simply be absent from the classpath of the gemma-rest WAR — that's the
        whole point of the split. The <s:http pattern="/rest/v2/**"> block currently
        in gemma-web's applicationContext-security.xml is replaced by the
        SecurityFilterChain @Bean in ubic.gemma.rest.security.RestSecurityConfig
        (which lives in this module and is picked up by gemma-rest's component-scan).
    -->
    <context-param>
        <param-name>contextConfigLocation</param-name>
        <param-value>classpath*:ubic/gemma/applicationContext-*.xml</param-value>
    </context-param>

    <!--
        ApplicationContextInitializer. Activates the `web` Spring profile (so beans gated on
        @Profile("web") — notably AnalyticsConfig and the <beans profile="web"> wrapper in
        applicationContext-analytics.xml — kick in) and runs the standard SpringContextUtils
        prepareContext work. The profile name is kept as `web` so existing @Profile("web") call
        sites in gemma-rest don't need re-gating; this is the gemma-rest-owned counterpart to
        gemma-web's ubic.gemma.web.context.InitializeContext (which stays in place for the
        legacy UI).
    -->
    <context-param>
        <param-name>contextInitializerClasses</param-name>
        <param-value>ubic.gemma.rest.context.RestInitializeContext</param-value>
    </context-param>

    <!--
        Listeners. Kept:
          - IntrospectorCleanupListener — prevents PropertyDescriptor leaks on undeploy
          - HttpSessionEventPublisher    — Spring Security session-lifecycle events
        Dropped (gemma-web-specific):
          - ubic.gemma.web.listener.StartupListener
          - ubic.gemma.web.listener.UserCounterListener
    -->
    <listener>
        <listener-class>org.springframework.web.util.IntrospectorCleanupListener</listener-class>
    </listener>
    <listener>
        <listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
    </listener>
    <listener>
        <listener-class>org.springframework.security.web.session.HttpSessionEventPublisher</listener-class>
    </listener>

    <!--
        CORS. Same wiring as gemma-web/web.xml:84–103 so gemma-curation-ui (the
        SPA replacing gemma-web) can hit /rest/v2/** cross-origin. The CorsFilter
        class itself lives in gemma-rest already (ubic.gemma.rest.servlet.CorsFilter),
        which is the right module — this descriptor just registers it.
    -->
    <filter>
        <filter-name>cors</filter-name>
        <filter-class>ubic.gemma.rest.servlet.CorsFilter</filter-class>
        <init-param>
            <param-name>allowedOrigins</param-name>
            <param-value>${cors.allowedOrigins}</param-value>
        </init-param>
        <init-param>
            <param-name>allowedHeaders</param-name>
            <param-value>Authorization,Content-Type,X-Gemma-Client-ID,X-Requested-With</param-value>
        </init-param>
        <init-param>
            <param-name>allowCredentials</param-name>
            <param-value>true</param-value>
        </init-param>
        <init-param>
            <param-name>maxAge</param-name>
            <param-value>1200</param-value>
        </init-param>
    </filter>

    <!--
        Spring Security filter chain. DelegatingFilterProxy looks up the
        springSecurityFilterChain bean assembled by RestSecurityConfig (SS6
        SecurityFilterChain @Bean — see that class for the full mapping from the
        legacy <s:http pattern="/rest/v2/**"> XML).
    -->
    <filter>
        <filter-name>springSecurityFilterChain</filter-name>
        <filter-class>org.springframework.web.filter.DelegatingFilterProxy</filter-class>
    </filter>

    <!--
        UTF-8 forcing. gemma-web mapped this to /j_spring_security_check + the
        DispatcherServlet only; for the REST WAR every request is /rest/v2/** and
        body decoding is Jersey-controlled, so a blanket /* mapping is both
        sufficient and harmless.
    -->
    <filter>
        <filter-name>encodingFilter</filter-name>
        <filter-class>org.springframework.web.filter.CharacterEncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
        <init-param>
            <param-name>forceEncoding</param-name>
            <param-value>true</param-value>
        </init-param>
    </filter>

    <!--
        Per-request MDC enrichment (requestId + userId). The gemma-rest counterpart of
        gemma-web's ubic.gemma.web.logging.RequestIdMdcFilter. See
        LOGGING_MODERNIZATION_RECCE.md §3 Phase 2 and the JSON template at
        gemma-core/src/main/resources/log4j2-json-template.json (the mdc block surfaces
        these keys in every JSON log line). Mapped below AFTER springSecurityFilterChain
        so SecurityContextHolder is populated by the time userId is resolved.
    -->
    <filter>
        <filter-name>requestIdMdcFilter</filter-name>
        <filter-class>ubic.gemma.rest.servlet.RequestIdMdcFilter</filter-class>
    </filter>

    <!--
        Filter ordering. Servlet spec evaluates <filter-mapping> elements in the
        order they appear in the descriptor. We need:
          1. encodingFilter (set charset before anything reads the body)
          2. cors           (must add Access-Control-* headers BEFORE security
                             potentially rejects with 401; gemma-web's comment
                             at web.xml:117–118 documented the same constraint)
          3. springSecurityFilterChain (authn/authz)
          4. requestIdMdcFilter        (populates MDC requestId + userId for log
                                        correlation — must run after the security
                                        chain so SecurityContextHolder is set)
    -->
    <filter-mapping>
        <filter-name>encodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>cors</filter-name>
        <url-pattern>/rest/v2/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>springSecurityFilterChain</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <!-- MDC enrichment must run AFTER springSecurityFilterChain so userId can be resolved
         from a populated SecurityContextHolder. -->
    <filter-mapping>
        <filter-name>requestIdMdcFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!--
        Jersey servlet. Init params copied verbatim from gemma-web/web.xml:176–198
        so the REST surface area is identical. Package-scan covers
        ubic.gemma.rest (the @Path resources) and the Swagger jaxrs2 integration.
        The two Jersey providers (GZipEncoder + Spring RequestContextFilter) are
        registered by classname. OpenAPI config is anchored to the gemma-rest
        context id and points at the openapi-configuration.yaml bundled in
        gemma-rest's classes.
    -->
    <servlet>
        <servlet-name>gemma-rest</servlet-name>
        <servlet-class>org.glassfish.jersey.servlet.ServletContainer</servlet-class>
        <init-param>
            <param-name>jersey.config.server.provider.packages</param-name>
            <param-value>io.swagger.v3.jaxrs2.integration.resources,ubic.gemma.rest</param-value>
        </init-param>
        <init-param>
            <param-name>jersey.config.server.provider.classnames</param-name>
            <param-value>org.glassfish.jersey.message.GZipEncoder,org.glassfish.jersey.server.spring.scope.RequestContextFilter</param-value>
        </init-param>
        <init-param>
            <param-name>openapi.context.id</param-name>
            <param-value>ubic.gemma.rest</param-value>
        </init-param>
        <init-param>
            <param-name>openApi.configuration.location</param-name>
            <param-value>/WEB-INF/classes/openapi-configuration.yaml</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <servlet-mapping>
        <servlet-name>gemma-rest</servlet-name>
        <url-pattern>/rest/v2/*</url-pattern>
    </servlet-mapping>

    <!--
        Static asset serving for the Swagger UI assets bundled under /resources/restapidocs/
        (see gemma-rest/pom.xml's gemma-rest-war profile webResources block). Tomcat's
        DefaultServlet handles the actual file I/O; the precompressed init-param lets it
        serve the *.gz variants that ship alongside swagger-ui-bundle.js / style.css.
        Mapping is /resources/* + extension globs, mirroring gemma-web/web.xml lines 244-278
        but trimmed to the asset types swagger-ui actually ships.

        The swagger UI landing page (gemma-rest/src/main/resources/restapidocs/index.html)
        is now a static HTML file served directly by the DefaultServlet — gemma-rest
        deliberately has no JSP support (no DispatcherServlet, no <jsp-config>). The
        page derives the context path client-side from window.location.pathname so the
        same file works for any deploy path. See RestapidocsIndexRewriteFilter for the
        /resources/restapidocs/ -> /resources/restapidocs/index.html rewrite.
    -->
    <servlet>
        <servlet-name>default</servlet-name>
        <servlet-class>org.apache.catalina.servlets.DefaultServlet</servlet-class>
        <init-param>
            <param-name>precompressed</param-name>
            <param-value>true</param-value>
        </init-param>
        <load-on-startup>0</load-on-startup>
    </servlet>

    <servlet-mapping>
        <servlet-name>default</servlet-name>
        <url-pattern>/resources/*</url-pattern>
        <url-pattern>*.js</url-pattern>
        <url-pattern>*.css</url-pattern>
        <url-pattern>*.map</url-pattern>
        <url-pattern>*.png</url-pattern>
        <url-pattern>*.svg</url-pattern>
        <url-pattern>*.ico</url-pattern>
        <url-pattern>*.woff</url-pattern>
        <url-pattern>*.woff2</url-pattern>
        <url-pattern>*.ttf</url-pattern>
    </servlet-mapping>

    <!--
        No <session-config>, no <error-page>, no <jsp-config>.
        gemma-rest is JSON-API-first:
          - Authn flows via HTTP Basic on every request (RestSecurityConfig sets
            SessionCreationPolicy.STATELESS), so JSESSIONID config is moot.
          - Error responses are emitted as JSON ResponseErrorObject by
            RestAuthEntryPoint + Jersey ExceptionMappers — no JSP fallback page.
          - Static assets under /resources/restapidocs/ are served by DefaultServlet
            above; everything else is /rest/v2/** Jersey.
    -->
</web-app>
