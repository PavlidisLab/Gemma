<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd"
       profile="cli">
    <!--
        Renovations Phase 3: the three <context:component-scan> blocks plus the
        LazyInitByDefaultPostProcessor <bean> that used to live here have moved to the Java
        @Configuration class ubic.gemma.cli.config.CliComponentScanConfig. This XML stub
        remains so the gemma-cli module continues to be picked up by the wildcard loader
        (classpath*:ubic/gemma/applicationContext-*.xml in SpringContextUtils and the CLI
        bootstrap) without any classpath-order surgery. The profile="cli" attribute is
        retained as belt-and-suspenders alongside the @Profile("cli") on the @Configuration.
    -->
    <bean class="ubic.gemma.cli.config.CliComponentScanConfig"/>
</beans>
