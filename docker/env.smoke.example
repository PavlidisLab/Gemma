# Smoke-test env file for gemma-rest container. Copy to env.smoke and fill
# in the secret values; never commit a real env.smoke (gitignored via the
# top-level .gitignore once Phase 3 lands).
#
#   cp docker/env.smoke.example docker/env.smoke
#   security find-generic-password -s gemma-db -w           >> ... etc.
#   docker run --env-file docker/env.smoke ...
#
# All variables follow the GEMMA_FOO_BAR -> gemma.foo.bar mapping documented
# in CONTAINER_CONFIG.md.

# --- Database (required; no defaults) -----------------------------------
GEMMA_DB_HOST=mysql
GEMMA_DB_PORT=3306
GEMMA_DB_NAME=gemd
GEMMA_DB_USER=gemmauser
GEMMA_DB_PASSWORD=CHANGEME

# --- Security tokens (required; no defaults) ----------------------------
# All three are placeholder-substituted into the security XML. Missing
# values trigger a hard PlaceholderResolutionException at startup.
GEMMA_AGENT_PASSWORD=CHANGEME
GEMMA_RUNAS_PASSWORD=CHANGEME
GEMMA_ANONYMOUSAUTH_KEY=CHANGEME

# --- Public-facing URLs / branding (have defaults but you SHOULD set) ---
GEMMA_HOSTURL=http://localhost:8080
GEMMA_ADMIN_EMAIL=admin@example.com
GEMMA_NOREPLY_EMAIL=noreply@example.com
GEMMA_SUPPORT_EMAIL=support@example.com

# --- Mail (default localhost:25 -- override if no MTA in the container) -
MAIL_HOST=localhost

# --- App-data path inside the container (default /data/gemma via image) -
# GEMMA_APPDATA_HOME=/data/gemma
