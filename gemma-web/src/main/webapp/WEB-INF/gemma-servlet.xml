<?xml version="1.0" encoding="UTF-8"?>
<!-- @author Gemma  -->

<beans xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:aop="http://www.springframework.org/schema/aop"
       xmlns="http://www.springframework.org/schema/beans"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
   http://www.springframework.org/schema/beans/spring-beans.xsd
   http://www.springframework.org/schema/aop http://www.springframework.org/schema/aop/spring-aop.xsd

   http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd">

    <!-- Note: the component-scan directive can be found in gemma-core's applicationContext-component-scan.xml -->
    <context:component-scan base-package="ubic.gemma.web.controller"
                            name-generator="ubic.gemma.core.context.BeanNameGenerator">
        <context:exclude-filter type="annotation" expression="ubic.gemma.core.context.TestComponent"/>
    </context:component-scan>

    <!-- The servlet uses a different Spring context with gemma-core's context as parent -->
    <!-- Unfortunately, bean post-processor do not get applied, so they must be redeclared here if we want them to apply
    to controllers -->
    <bean class="org.springframework.context.support.PropertySourcesPlaceholderConfigurer">
        <property name="propertySources" ref="settingsPropertySources"/>
    </bean>

    <!-- Mapping URLS to controllers -->


    <!-- This is provided by spring by default, but this declaration is needed because we define other mappers, and to allow
        configuration of the interceptor; otherwise this would be configured by default. TODO: switch to RequestMappingHandlerMapping -->
    <bean class="org.springframework.web.servlet.mvc.annotation.DefaultAnnotationHandlerMapping">
        <property name="order" value="1"/>
    </bean>

    <!-- see http://static.springsource.org/spring/docs/3.0.x/spring-framework-reference/html/ch15s10.html -->
    <bean id="viewNameTranslator" class="org.springframework.web.servlet.view.DefaultRequestToViewNameTranslator"/>

    <!-- explicit mappings of patterns to urls -->
    <bean id="simpleUrlMapping" class="org.springframework.web.servlet.handler.SimpleUrlHandlerMapping">
        <property name="order" value="3"/>
        <property name="alwaysUseFullPath" value="true"/>
        <property name="mappings"><!-- replace with annotations ... -->
            <props>
                <prop key="/uploadFile.html">fileUploadController</prop>
                <prop key="/bibRef/*">bibliographicReferenceController</prop>
                <prop key="/arrayDesign/*">arrayDesignFormController</prop>
                <!-- <prop key="/arrayDesign/associateSequences.html">arrayDesignSequenceAddController</prop> deprecated -->
                <prop key="/bioMaterial/*">bioMaterialController</prop>
                <prop key="/compositeSequence/*">compositeSequenceController</prop>
                <prop key="/experimentalDesign/*">experimentalDesignController</prop>
                <prop key="/getData.html">expressionExperimentDataFetchController</prop>
                <prop key="/getMetaData.html">expressionExperimentDataFetchController</prop>
                <prop key="/checkJobProgress.html">taskCompletionController</prop>
                <prop key="/searchCoexpression.html">coexpressionSearchController</prop>
                <prop key="/gene/*">geneController</prop>
                <prop key="/blatTrack.html">blatResultTrackController</prop>
                <prop key="/admin/systemStats.html">systemStatsController</prop>
                <prop key="/diff/diffExpressionAnalysis.html">differentialExpressionAnalysisController</prop>
                <prop key="/diff/diffExpressionSearch.html">differentialExpressionSearchController</prop>
                <prop key="/home.html">homePageController</prop>
            </props>
        </property>
    </bean>

    <!-- default mapping, as a fallback. Avoid using. -->
    <bean id="beanNameUrlHandlerMapping" class="org.springframework.web.servlet.handler.BeanNameUrlHandlerMapping">
        <property name="order" value="4"/>
    </bean>

    <!-- ==================================================== -->
    <!-- Mapping urls to views. List views here that are just jsps and that don't need a controller. -->
    <!-- ==================================================== -->
    <bean class="org.springframework.web.servlet.mvc.UrlFilenameViewController" name="/register.html"/>
    <bean class="org.springframework.web.servlet.mvc.UrlFilenameViewController" name="/userProfile.html"/>
    <bean class="org.springframework.web.servlet.mvc.UrlFilenameViewController" name="/manageGroups.html"/>
    <bean class="org.springframework.web.servlet.mvc.UrlFilenameViewController" name="/geneGroupManager.html"/>
    <bean class="org.springframework.web.servlet.mvc.UrlFilenameViewController" name="/passwordHint.html"/>
    <bean class="org.springframework.web.servlet.mvc.UrlFilenameViewController" name="/admin/userManager.html"/>
    <bean class="org.springframework.web.servlet.mvc.UrlFilenameViewController" name="/admin/indexer.html"/>
    <bean class="org.springframework.web.servlet.mvc.UrlFilenameViewController" name="/admin/widgetTest.html"/>
    <bean class="org.springframework.web.servlet.mvc.UrlFilenameViewController" name="/admin/geoRecordBrowser.html"/>
    <bean class="org.springframework.web.servlet.mvc.UrlFilenameViewController" name="/contactUs.html"/>
    <bean class="org.springframework.web.servlet.mvc.UrlFilenameViewController" name="/analysesResultsSearch.html"/>
    <bean class="org.springframework.web.servlet.mvc.UrlFilenameViewController" name="/expressionExperiments.html"/>
    <bean class="org.springframework.web.servlet.mvc.UrlFilenameViewController"
          name="/expressionExperimentSetManager.html"/>
    <bean class="org.springframework.web.servlet.mvc.UrlFilenameViewController"
          name="/expressionExperimentsWithQC.html"/>

    <!-- ==================================================== -->
    <!-- Exception handler. -->
    <!-- ==================================================== -->
    <bean id="exceptionResolver" class="ubic.gemma.web.controller.util.DefaultHandlerExceptionResolver"/>

    <!-- Used for file uploads. Phase 2: Spring 6 dropped Commons FileUpload support; switched to the standard
         Servlet 3 multipart resolver. The size limit is now configured on the &lt;multipart-config&gt; in web.xml. -->
    <bean id="multipartResolver" class="org.springframework.web.multipart.support.StandardServletMultipartResolver"/>
    <!-- # 100 megabytes # 104857600 # 20 megabytes gemma.max.fileupload.size.bytes= -->
    <!-- View Resolver for JSPs. This means that a jsp named "myform.jsp" can be referred to as "myform" in your controller
        bean declarations. -->
    <bean id="viewResolver" class="org.springframework.web.servlet.view.InternalResourceViewResolver">
        <property name="requestContextAttribute" value="rc"/>
        <property name="viewClass" value="org.springframework.web.servlet.view.JstlView"/>
        <property name="prefix" value="/pages/"/>
        <property name="suffix" value=".jsp"/>
    </bean>

    <bean id="arrayDesignFormController"
          class="ubic.gemma.web.controller.expression.arrayDesign.ArrayDesignFormController">
        <property name="commandName" value="arrayDesign"/>
        <property name="commandClass" value="ubic.gemma.model.expression.arrayDesign.ArrayDesignValueObject"/>
        <property name="formView" value="arrayDesign.edit"/>
        <property name="successView" value="redirect:/arrays/showAllArrayDesigns.html"/>
        <property name="arrayDesignService" ref="arrayDesignService"/>
        <property name="messageUtil" ref="messageUtil"/>
    </bean>


</beans>
